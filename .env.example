# Puerto del servidor
PORT=3000

# MongoDB Atlas (si falta o no conecta, se usa MONGODB_URI_LOCAL)
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/TP2
MONGODB_URI_LOCAL=mongodb://127.0.0.1:27017/TP2

# Sesiones: valor largo y aleatorio (obligatorio)
SESSION_SECRET=cambiar_por_un_valor_largo_y_aleatorio
SESSION_MAX_AGE_HORAS=8

# development | production (en production la cookie de sesión exige HTTPS)
NODE_ENV=development

# JWT para la API (/auth/token). Si falta, se deriva de SESSION_SECRET
JWT_SECRET=cambiar_por_otro_valor_largo_y_aleatorio
JWT_EXPIRA=1h
