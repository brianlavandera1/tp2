doctype html
include partials/logo.pug
include partials/conectados.pug
include partials/chat.pug
include partials/iconos.pug
html(lang="es")
  head
    include partials/head.pug
    include partials/estilosUrbana.pug
    +scriptConectados()
    title
      block titulo
        | Urbana Cult · Entradas para eventos
    block headStyles
  body
    .sitio
      //- ENCABEZADO: marca, menú principal, carrito y usuario
      header.encabezado
        .contenedor
          //- El sitio se ve sin sesión; "Mis entradas" y el carrito aparecen al entrar como cliente
          - const esCliente = usuarioLogueado && usuarioLogueado.rol === 'Cliente'
          +logoMarca("/cliente/menu", "Entradas", esCliente ? usuarioLogueado.tipoCliente : null)

          - const enlaces = [['/cliente/menu', 'Inicio', 'inicio'], ['/cliente/comprar', 'Cartelera', 'cartelera'], esCliente && ['/cliente/mis-compras', 'Mis entradas', 'entrada'], ['/cliente/membresia', 'Plan', 'plan'], ['/ayuda', 'Ayuda', 'ayuda']].filter(Boolean)
          nav.nav-principal(aria-label="Menú principal")
            each enlace in enlaces
              a(href=enlace[0] class=(rutaActual === enlace[0] ? 'activo' : '') aria-current=(rutaActual === enlace[0] ? 'page' : undefined))= enlace[1]

          .acciones-usuario
            if esCliente
              a.boton-carrito(href="/cliente/carrito" aria-label="Ver carrito")
                +icono('carrito')
                span.contador#contador-carrito(class=(itemsCarrito ? '' : 'oculto'))= itemsCarrito
              a.chip-usuario(href="/cliente/configuracion" title="Mi perfil" aria-label="Mi perfil")
                span.avatar= usuarioLogueado.nombreUsuario.charAt(0)
            else if usuarioLogueado
              a.btn.btn-chico(href="/admin/dashboard") Volver al panel
            else
              a.entrar(href="/auth/login") Iniciar sesión
              a.btn.btn-chico.crear-cuenta(href="/auth/registro") Crear cuenta
            if usuarioLogueado
              a.salir(href="/auth/logout")
                +icono('salir')
                span Salir

      //- CONTENIDO DINÁMICO DE CADA VISTA
      main
        .contenedor
          block content

      footer.pie
        .contenedor
          span © #{new Date().getFullYear()} Urbana Cult
          a(href="/ayuda") Centro de ayuda
          span.credito Desarrollado por #[strong Sintaxia]

      //- NAVEGACIÓN DEL CELULAR: barra fija abajo, como una app
      - const barra = esCliente ? [['/cliente/menu', 'Inicio', 'inicio'], ['/cliente/comprar', 'Cartelera', 'cartelera'], ['/cliente/mis-compras', 'Entradas', 'entrada'], ['/cliente/membresia', 'Plan', 'plan'], ['/cliente/configuracion', 'Perfil', 'perfil']] : [['/cliente/menu', 'Inicio', 'inicio'], ['/cliente/comprar', 'Cartelera', 'cartelera'], ['/cliente/membresia', 'Plan', 'plan'], ['/ayuda', 'Ayuda', 'ayuda'], usuarioLogueado ? ['/admin/dashboard', 'Panel', 'perfil'] : ['/auth/login', 'Entrar', 'perfil']]
      nav.barra-app(aria-label="Navegación principal")
        each enlace in barra
          a(href=enlace[0] class=(rutaActual === enlace[0] ? 'activo' : '') aria-current=(rutaActual === enlace[0] ? 'page' : undefined))
            +icono(enlace[2])
            span= enlace[1]

      //- El personal de la empresa no usa el chat
      if esCliente || !usuarioLogueado
        +chatFlotante()

