doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title Portal de Cliente - Mi Empresa
    block headStyles
  body(style="font-family: 'Segoe UI', system-ui, sans-serif; background-color: #f8fafc; color: #1e293b; margin: 0; padding: 20px; box-sizing: border-box;")
    
    div(style="max-width: 1100px; margin: 0 auto;")
      
      //- ENCABEZADO / HEADER DEL CLIENTE
      div(style="background: #ffffff; padding: 20px 30px; border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px; border: 1px solid #e2e8f0;")
        div
          h1(style="margin: 0; font-size: 22px; color: #0f172a;") 🎟️ Portal de Cliente
          if usuarioLogueado
            p(style="margin: 5px 0 0 0; color: #64748b; font-size: 13px;") 
              | Hola, <strong>#{usuarioLogueado.nombreUsuario}</strong> | 
              | Plan: <span style="color: #0284c7; font-weight: bold;">#{usuarioLogueado.tipoCliente || 'ESTANDAR'}</span>
        
        div(style="display: flex; gap: 10px; align-items: center;")
          a(href="/auth/logout" style="background: #fee2e2; color: #dc2626; padding: 8px 16px; border-radius: 8px; text-decoration: none; font-size: 13px; font-weight: bold; border: 1px solid #fecaca;") 🚪 Salir

      //- BARRA DE NAVEGACIÓN (Incluye el botón de Configurar Perfil a la derecha)
      nav(style="background: #ffffff; padding: 12px 20px; border-radius: 10px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); margin-bottom: 25px; display: flex; gap: 10px; flex-wrap: wrap; border: 1px solid #e2e8f0; align-items: center;")
        span(style="font-size: 12px; font-weight: bold; color: #94a3b8; text-transform: uppercase; margin-right: 5px;") 📌 Menú:
        a(href="/cliente/menu" style="color: #475569; text-decoration: none; font-size: 13px; font-weight: 600; padding: 7px 12px; border-radius: 6px; background: #f1f5f9;") 🏠 Inicio
        a(href="/cliente/comprar" style="color: #475569; text-decoration: none; font-size: 13px; font-weight: 600; padding: 7px 12px; border-radius: 6px; background: #f1f5f9;") 🎟️ Cartelera
        a(href="/cliente/carrito" style="color: #475569; text-decoration: none; font-size: 13px; font-weight: 600; padding: 7px 12px; border-radius: 6px; background: #f1f5f9;") 🛒 Mi Carrito
        a(href="/cliente/mis-compras" style="color: #475569; text-decoration: none; font-size: 13px; font-weight: 600; padding: 7px 12px; border-radius: 6px; background: #f1f5f9;") 📦 Mis Entradas
        a(href="/cliente/membresia" style="color: #475569; text-decoration: none; font-size: 13px; font-weight: 600; padding: 7px 12px; border-radius: 6px; background: #f1f5f9;") ⭐ Membresía
        
        //- Botón de Configuración alineado a la derecha
        a(href="/cliente/configuracion" style="color: #0284c7; text-decoration: none; font-size: 13px; font-weight: 600; padding: 7px 14px; border-radius: 6px; background: #e0f2fe; margin-left: auto; border: 1px solid #bae6fd;") ⚙️ Configurar Perfil

      //- CONTENIDO DINÁMICO DE CADA VISTA
      block content