doctype html
include partials/logo.pug
html(lang="es")
  head
    include partials/head.pug
    title
      block titulo
        | Urbana Cult · Entradas para eventos
    block headStyles
  body
    .sitio
      //- ENCABEZADO: marca, menú principal, carrito y usuario
      header.encabezado
        .contenedor
          +logoMarca("/cliente/menu", "Entradas")

          - const enlaces = [['/cliente/menu', 'Inicio'], ['/cliente/comprar', 'Cartelera'], ['/cliente/mis-compras', 'Mis entradas'], ['/cliente/membresia', 'Membresía']]
          nav.nav-principal(aria-label="Menú principal")
            each enlace in enlaces
              a(href=enlace[0] class=(rutaActual === enlace[0] ? 'activo' : '') aria-current=(rutaActual === enlace[0] ? 'page' : undefined))= enlace[1]

          .acciones-usuario
            a.boton-carrito(href="/cliente/carrito" aria-label="Ver carrito")
              | 🛒 Carrito
              span.contador#contador-carrito(class=(itemsCarrito ? '' : 'oculto'))= itemsCarrito
            if usuarioLogueado
              a.chip-usuario(href="/cliente/configuracion" title="Configurar perfil")
                span.avatar= usuarioLogueado.nombreUsuario.charAt(0)
                span.texto-chip
                  span.nombre= usuarioLogueado.nombreUsuario
                  br
                  span.plan Plan #{usuarioLogueado.tipoCliente || 'ESTANDAR'}
              a.salir(href="/auth/logout") Salir

      //- CONTENIDO DINÁMICO DE CADA VISTA
      main
        .contenedor
          block content

      footer.pie
        .contenedor
          span © #{new Date().getFullYear()} Urbana Cult · Venta de entradas para eventos culturales
          span
            a(href="/cliente/comprar") Cartelera
            |  · #[a(href="/cliente/configuracion") Mi perfil]
          span.credito Desarrollado por #[strong Sintaxia]
