//- Logo de Urbana Cult (SVG propio): una entrada troquelada con la "U" de Urbana y un destello dorado.
//- Se dibuja en línea para no depender de archivos de imagen. `tam` = tamaño en píxeles.
mixin logoIcono(tam, plan)
  - tam = tam || 38
  - const colores = { VIP: ['#fff3c4', '#f2c94c', '#b8860b'], PREMIUM: ['#ffffff', '#c3cbe6', '#7f8bb8'] }[plan] || ['#6d4dff', '#b23cf0', '#ff4d7d']
  - const idFondo = `uc-fondo-${plan === 'VIP' || plan === 'PREMIUM' ? plan : 'normal'}`
  - const trazoU = ['VIP', 'PREMIUM'].includes(plan) ? '#231a3d' : '#ffffff'
  svg.logo-icono(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width=tam height=tam role="img" aria-label="Urbana Cult")
    defs
      linearGradient(id=idFondo x1="0" y1="0" x2="1" y2="1")
        stop(offset="0" stop-color=colores[0])
        stop(offset=".55" stop-color=colores[1])
        stop(offset="1" stop-color=colores[2])
      linearGradient#uc-brillo(x1="0" y1="0" x2="0" y2="1")
        stop(offset="0" stop-color="#ffffff" stop-opacity=".35")
        stop(offset=".5" stop-color="#ffffff" stop-opacity="0")
      linearGradient#uc-oro(x1="0" y1="0" x2="1" y2="1")
        stop(offset="0" stop-color="#fff3c4")
        stop(offset=".5" stop-color="#f2c94c")
        stop(offset="1" stop-color="#d4af37")
    //- Entrada con muescas a los costados
    path(d="M10 8H38A7 7 0 0 1 45 15V20A4 4 0 0 0 45 28V33A7 7 0 0 1 38 40H10A7 7 0 0 1 3 33V28A4 4 0 0 0 3 20V15A7 7 0 0 1 10 8Z" fill=`url(#${idFondo})`)
    path(d="M10 8H38A7 7 0 0 1 45 15V20A4 4 0 0 0 45 28V33A7 7 0 0 1 38 40H10A7 7 0 0 1 3 33V28A4 4 0 0 0 3 20V15A7 7 0 0 1 10 8Z" fill="url(#uc-brillo)")
    //- "U" de Urbana
    path(d="M14.5 15.5V24.5A7.5 7.5 0 0 0 29.5 24.5V15.5" fill="none" stroke=trazoU stroke-width="4.6" stroke-linecap="round")
    //- Destello dorado (el "Cult": cultura, escenario, show)
    path(d="M37 11.5L38.3 14.7L41.5 16L38.3 17.3L37 20.5L35.7 17.3L32.5 16L35.7 14.7Z" fill=(plan === 'VIP' || plan === 'PREMIUM' ? trazoU : 'url(#uc-oro)'))
    path(d="M37.5 26L38.2 27.8L40 28.5L38.2 29.2L37.5 31L36.8 29.2L35 28.5L36.8 27.8Z" fill=(plan === 'VIP' || plan === 'PREMIUM' ? trazoU : '#ffffff') fill-opacity=".7")

//- Logo completo: ícono + nombre. `subtitulo` = texto chico debajo (Entradas, Gestión...)
//- `plan` = plan del cliente (VIP dorado, PREMIUM plateado; cualquier otro, el logo normal)
mixin logoMarca(href, subtitulo, plan)
  - const nombrePlan = { VIP: 'VIP', PREMIUM: 'Premium' }[plan]
  a.marca(href=href class=(nombrePlan ? `marca-${plan.toLowerCase()}` : '') title=(nombrePlan ? `Plan ${nombrePlan}` : undefined) aria-label=(nombrePlan ? `Urbana Cult, plan ${nombrePlan}, ir al inicio` : 'Urbana Cult, ir al inicio'))
    +logoIcono(38, plan)
    span.marca-texto
      span.marca-nombre Urbana #[span.marca-cult Cult]
      if nombrePlan
        span.marca-plan Plan #{nombrePlan}
      if subtitulo
        small= subtitulo
