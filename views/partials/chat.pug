//- Chat en tiempo real (Socket.IO) con Gemini como usuario virtual. El servidor está en sockets/chat.js.
//- Usa la conexión que abre partials/conectados.pug. Clientes: sala compartida. Visitas: conversación privada con Gemini.
mixin chatFlotante()
  - const saludoNombre = usuarioLogueado ? `, ${usuarioLogueado.nombreUsuario}` : ''
  style.
    .chat-flotante { position: fixed; right: 20px; bottom: 20px; z-index: 60; }
    .chat-flotante[hidden], .chat-flotante [hidden] { display: none !important; }
    .chat-boton { position: relative; width: 54px; height: 54px; display: grid; place-items: center; border: 0; border-radius: 50%; background: var(--degrade); color: #fff; cursor: pointer; box-shadow: 0 10px 28px rgba(0, 0, 0, .45); }
    .chat-punto { position: absolute; top: 2px; right: 2px; width: 13px; height: 13px; border-radius: 50%; background: var(--color-aviso); border: 2px solid var(--noche); }
    .chat-panel { position: absolute; right: 0; bottom: 66px; width: 360px; height: min(520px, calc(100dvh - 120px)); display: flex; flex-direction: column; background: var(--color-superficie); border: 1px solid var(--color-borde); border-radius: 18px; overflow: hidden; box-shadow: 0 24px 60px rgba(0, 0, 0, .5); }
    .chat-cabecera { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 12px 14px; border-bottom: 1px solid var(--color-borde); }
    .chat-cabecera strong { display: block; color: #fff; font-size: 15px; }
    .chat-cabecera small { color: var(--color-texto-tenue); font-size: 12px; }
    .chat-cerrar { width: 32px; height: 32px; border: 0; border-radius: 50%; background: transparent; color: var(--color-texto-suave); font-size: 20px; line-height: 1; cursor: pointer; }
    .chat-cerrar:hover { background: var(--color-marca-suave); color: #fff; }
    .chat-lista { flex: 1; display: flex; flex-direction: column; gap: 10px; padding: 14px; overflow-y: auto; }
    .chat-sugerencias { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
    .chat-sugerencias button { padding: 5px 10px; border: 1px solid var(--color-marca); border-radius: 999px; background: transparent; color: var(--enlace); font: inherit; font-size: 12px; cursor: pointer; }
    .chat-sugerencias button:hover { background: var(--color-marca-suave); color: #fff; }
    .chat-mensaje { align-self: flex-start; max-width: 85%; padding: 8px 12px; border-radius: 14px; background: rgba(255, 255, 255, .08); }
    .chat-mensaje.propio { align-self: flex-end; background: var(--color-marca-suave); }
    .chat-mensaje.es-ia { border: 1px solid var(--color-marca); }
    .chat-autor { display: block; margin-bottom: 2px; color: var(--enlace); font-size: 11.5px; font-weight: 600; }
    .chat-texto { color: var(--color-texto); font-size: 13.5px; line-height: 1.45; white-space: pre-wrap; overflow-wrap: anywhere; }
    .chat-estado { margin: 0; padding: 0 14px 8px; color: var(--color-texto-tenue); font-size: 12px; }
    .chat-estado.chat-error { color: var(--color-aviso); }
    .chat-invitacion a { margin-left: 4px; font-weight: 600; }
    .chat-form { display: flex; gap: 8px; padding: 10px; border-top: 1px solid var(--color-borde); }
    .chat-prefijo { align-self: center; color: var(--enlace); font-size: 13px; font-weight: 600; }
    .chat-form input { flex: 1; min-width: 0; padding: 10px 12px; border-radius: 12px; font-size: 16px; }
    .chat-form button { padding: 0 14px; border: 0; border-radius: 12px; background: var(--degrade); color: #fff; font-weight: 600; cursor: pointer; }
    @media (max-width: 960px) { .chat-flotante.con-barra { bottom: 82px; } }
    @media (max-width: 480px) {
      .chat-flotante { right: 14px; }
      .chat-panel { position: fixed; left: 8px; right: 8px; top: 8px; bottom: 8px; width: auto; height: auto; }
      .chat-panel:not([hidden]) + .chat-boton { display: none; }
    }
    @media print { .chat-flotante { display: none !important; } }

  .chat-flotante(data-usuario=(usuarioLogueado ? usuarioLogueado.nombreUsuario : 'Vos') data-visita=(usuarioLogueado ? undefined : 'si') hidden)
    #chat-panel.chat-panel(role="dialog" aria-label="Chat en vivo" hidden)
      .chat-cabecera
        div
          strong Chat en vivo
          small Preguntá lo que quieras y te responde Gemini
        button.chat-cerrar(type="button" aria-label="Cerrar chat") ×
      .chat-lista(role="log" aria-live="polite")
        //- Saludo fijo: no consulta a la IA, así no gasta el cupo de Gemini cada vez que se abre una página
        .chat-mensaje.es-ia
          span.chat-autor Gemini
          .chat-texto ¡Hola#{saludoNombre}! ¿Tenés dudas? Tocá una pregunta o escribime acá abajo.
          .chat-sugerencias
            button(type="button" data-pregunta="¿Qué planes hay?") ¿Qué planes hay?
            button(type="button" data-pregunta="¿Cómo compro una entrada?") ¿Cómo compro?
            button(type="button" data-pregunta="¿Cómo cancelo una entrada?") ¿Cómo cancelo?
      p.chat-estado.chat-pensando(hidden) Gemini está escribiendo…
      p.chat-estado.chat-error(role="status" hidden)
      p.chat-estado.chat-invitacion(role="status" hidden)
        span
        a(href="/auth/registro") Creá tu cuenta gratis
      form.chat-form(autocomplete="off")
        span.chat-prefijo(aria-hidden="true") @gemini
        input(type="text" maxlength="490" placeholder="Escribí tu pregunta…" aria-label="Pregunta para Gemini")
        button(type="submit") Enviar
    button.chat-boton(type="button" aria-label="Abrir chat" aria-expanded="false" aria-controls="chat-panel")
      svg(xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
        path(d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z")
      span.chat-punto(hidden)

  script.
    document.addEventListener('DOMContentLoaded', () => {
      const raiz = document.querySelector('.chat-flotante');
      const socket = window.socketUrbana;
      if (!socket) return; // sin servidor de sockets (Vercel) el chat no se muestra
      raiz.hidden = false;
      raiz.classList.toggle('con-barra', Boolean(document.querySelector('.barra-app')));

      const panel = raiz.querySelector('.chat-panel');
      const boton = raiz.querySelector('.chat-boton');
      const punto = raiz.querySelector('.chat-punto');
      const lista = raiz.querySelector('.chat-lista');
      const pensando = raiz.querySelector('.chat-pensando');
      const error = raiz.querySelector('.chat-error');
      const invitacion = raiz.querySelector('.chat-invitacion');
      const formulario = raiz.querySelector('.chat-form');
      const campo = formulario.querySelector('input');

      const recordarAbierto = (valor) => { try { sessionStorage.setItem('uc-chat-abierto', valor ? '1' : ''); } catch {} };
      const estabaAbierto = () => { try { return Boolean(sessionStorage.getItem('uc-chat-abierto')); } catch { return false; } };
      const bajar = () => { lista.scrollTop = lista.scrollHeight; };

      const abrir = (valor, enfocar) => {
        panel.hidden = !valor;
        boton.setAttribute('aria-expanded', String(valor));
        recordarAbierto(valor);
        if (valor) { punto.hidden = true; bajar(); if (enfocar) campo.focus(); }
      };
      boton.addEventListener('click', () => abrir(panel.hidden, true));
      raiz.querySelector('.chat-cerrar').addEventListener('click', () => { abrir(false); boton.focus(); });
      abrir(estabaAbierto(), false);

      // Siempre textContent: lo que escribe la gente (o la IA) nunca se interpreta como HTML
      const pintar = (datos) => {
        const mensaje = document.createElement('div');
        mensaje.className = 'chat-mensaje';
        if (datos.esIA) mensaje.classList.add('es-ia');
        else if (datos.usuario === raiz.dataset.usuario) mensaje.classList.add('propio');
        const autor = document.createElement('span');
        autor.className = 'chat-autor';
        autor.textContent = datos.usuario;
        const texto = document.createElement('div');
        texto.className = 'chat-texto';
        texto.textContent = datos.mensaje;
        mensaje.append(autor, texto);
        lista.append(mensaje);
        bajar();
      };

      const saludo = lista.firstElementChild;
      socket.on('historial', (mensajes) => { lista.replaceChildren(saludo); mensajes.forEach(pintar); });
      // El sitio tiene varias páginas: la conversación privada de una visita se guarda en esta pestaña
      const esVisita = raiz.dataset.visita === 'si';
      const conversacion = [];
      const recordar = (datos) => {
        conversacion.push(datos);
        if (conversacion.length > 30) conversacion.shift();
        try { sessionStorage.setItem('uc-chat-visita', JSON.stringify(conversacion)); } catch {}
      };
      if (esVisita) {
        try { JSON.parse(sessionStorage.getItem('uc-chat-visita') || '[]').forEach((datos) => { conversacion.push(datos); pintar(datos); }); } catch {}
      }

      socket.on('mensaje', (datos) => {
        pintar(datos);
        if (esVisita) recordar(datos);
        if (panel.hidden) punto.hidden = false;
      });
      socket.on('gemini-pensando', (activo) => { pensando.hidden = !activo; });
      let ultimoEscrito = '';
      socket.on('aviso', (texto, rechazado) => {
        error.textContent = texto;
        error.hidden = false;
        if (rechazado && !campo.value) campo.value = ultimoEscrito; // no se pierde lo que escribió
      });
      socket.on('invitar-registro', (texto) => {
        invitacion.firstElementChild.textContent = texto;
        invitacion.hidden = false;
        if (!campo.value) campo.value = ultimoEscrito;
      });

      const enviar = (texto) => {
        error.hidden = true;
        invitacion.hidden = true;
        socket.emit('mensaje', { mensaje: texto });
      };

      saludo.addEventListener('click', (evento) => {
        const opcion = evento.target.closest('[data-pregunta]');
        if (!opcion) return;
        ultimoEscrito = '';
        enviar(`@gemini ${opcion.dataset.pregunta}`);
      });

      formulario.addEventListener('submit', (evento) => {
        evento.preventDefault();
        const texto = campo.value.trim();
        if (!texto) return;
        ultimoEscrito = texto;
        // El prefijo se agrega solo: la persona escribe únicamente su pregunta
        enviar(texto.toLowerCase().startsWith('@gemini') ? texto : `@gemini ${texto}`);
        campo.value = '';
      });
    });
