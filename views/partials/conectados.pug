//- Conteo en tiempo real de usuarios conectados (Socket.IO). El servidor está en sockets/conectados.js.

//- Va en el <head>: abre la conexión y actualiza cada contador de la página.
mixin scriptConectados()
  style.
    .panel-barra { display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; margin-bottom: 14px; }
    .panel-barra .ruta-seccion { margin: 0; }
    .conectados { display: inline-flex; align-items: center; gap: 8px; margin-left: auto; padding: 7px 14px; border: 1px solid var(--color-borde); border-radius: 999px; background: var(--color-superficie); color: #fff; font-size: 13.5px; font-weight: 600; white-space: nowrap; }
    .conectados[hidden] { display: none; }
    @media print { .conectados { display: none !important; } }
    .conectados-punto { width: 8px; height: 8px; border-radius: 50%; background: var(--color-exito); box-shadow: 0 0 0 3px var(--color-exito-suave); }
  script(src="/socket.io/socket.io.min.js" defer)
  script.
    document.addEventListener('DOMContentLoaded', () => {
      if (!window.io) return; // sin servidor de sockets (Vercel) el contador queda oculto
      // Identifica al navegador, para que varias pestañas cuenten como un solo usuario
      let visitante;
      try {
        visitante = localStorage.getItem('uc-visitante');
        if (!visitante) {
          visitante = Date.now().toString(36) + Math.random().toString(36).slice(2);
          localStorage.setItem('uc-visitante', visitante);
        }
      } catch { /* sin almacenamiento: el servidor cuenta esta conexión sola */ }

      const contadores = document.querySelectorAll('[data-conectados]');
      const socket = io({ auth: { visitante } });
      window.socketUrbana = socket; // la misma conexión la usa el chat (partials/chat.pug)
      socket.on('usuarios-conectados', (total) => {
        contadores.forEach((contador) => {
          contador.lastElementChild.textContent = total === 1 ? '1 usuario conectado' : `${total} usuarios conectados`;
          contador.hidden = false;
        });
      });
      socket.on('disconnect', () => contadores.forEach((contador) => { contador.hidden = true; }));
    });

//- El contador visible (solo en el panel de la empresa): empieza oculto y aparece cuando llega el primer dato.
mixin contadorConectados()
  span.conectados(data-conectados hidden)
    span.conectados-punto(aria-hidden="true")
    span
