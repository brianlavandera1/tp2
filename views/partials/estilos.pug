style.
  /* =========================================================
     Urbana Cult · hoja de estilos común
     Tokens → base → layouts (sitio, panel, acceso) → componentes
     ========================================================= */
  
  :root {
    --color-fondo: #f6f7fb;
    --color-superficie: #ffffff;
    --color-superficie-2: #f1f3f9;
    --color-borde: #e3e6ef;
    --color-texto: #161a2b;
    --color-texto-suave: #5b6275;
    --color-texto-tenue: #8a90a2;
  
    --color-marca: #5b3df5;
    --color-marca-oscuro: #4326d9;
    --color-marca-suave: #eeeaff;
    --color-acento: #ff4d7d;
  
    --color-exito: #12a150;
    --color-exito-suave: #e3f7ec;
    --color-error: #dc2f45;
    --color-error-suave: #fdeaed;
    --color-aviso: #c27803;
    --color-aviso-suave: #fff4dc;
    --color-info: #1d6fd6;
    --color-info-suave: #e6f0fd;
  
    --color-oscuro: #12101f;
    --color-oscuro-2: #1d1a33;
  
    --radio: 14px;
    --radio-sm: 9px;
    --sombra: 0 1px 2px rgba(22, 26, 43, .05), 0 4px 16px rgba(22, 26, 43, .06);
    --sombra-alta: 0 10px 30px rgba(22, 26, 43, .12);
    --ancho-max: 1180px;
    --fuente: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  }
  
  /* ---------- Base ---------- */
  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    font-family: var(--fuente);
    font-size: 15px;
    line-height: 1.55;
    color: var(--color-texto);
    background: var(--color-fondo);
  }
  h1, h2, h3, h4 { margin: 0 0 .4em; line-height: 1.2; letter-spacing: -.01em; }
  h1 { font-size: 30px; font-weight: 800; }
  h2 { font-size: 22px; font-weight: 700; }
  h3 { font-size: 18px; font-weight: 700; }
  h4 { font-size: 15px; font-weight: 700; }
  p { margin: 0 0 .8em; }
  a { color: var(--color-marca); text-decoration: none; }
  a:hover { color: var(--color-marca-oscuro); }
  img { max-width: 100%; }
  :focus-visible { outline: 3px solid var(--color-marca); outline-offset: 2px; border-radius: 4px; }
  
  .contenedor { width: 100%; max-width: var(--ancho-max); margin: 0 auto; padding: 0 20px; }
  .texto-suave { color: var(--color-texto-suave); }
  .texto-tenue { color: var(--color-texto-tenue); font-size: 13px; }
  .texto-exito { color: var(--color-exito); }
  .texto-error { color: var(--color-error); }
  .negrita { font-weight: 700; }
  .centrado { text-align: center; }
  .derecha { text-align: right; }
  .mt-0 { margin-top: 0; } .mb-0 { margin-bottom: 0; }
  .mt { margin-top: 20px; } .mb { margin-bottom: 20px; }
  .oculto { display: none !important; }
  .fila { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
  .fila-entre { display: flex; gap: 12px; align-items: center; justify-content: space-between; flex-wrap: wrap; }
  .empujar { margin-left: auto; }
  
  /* ---------- Layout: sitio del cliente ---------- */
  .sitio { min-height: 100vh; display: flex; flex-direction: column; }
  .sitio main { flex: 1; padding: 28px 0 56px; }
  
  .encabezado {
    position: sticky; top: 0; z-index: 50;
    background: var(--color-oscuro);
    color: #fff;
    box-shadow: 0 2px 12px rgba(0, 0, 0, .18);
  }
  .encabezado .contenedor { display: flex; align-items: center; gap: 24px; min-height: 66px; flex-wrap: wrap; }
  /* Logo: ícono SVG (entrada troquelada + "U" + destello) y nombre con "Cult" en degradé */
  .marca { display: inline-flex; align-items: center; gap: 11px; color: #fff; font-weight: 800; font-size: 20px; letter-spacing: -.02em; line-height: 1.1; }
  .marca:hover { color: #fff; }
  .logo-icono { flex-shrink: 0; display: block; filter: drop-shadow(0 4px 10px rgba(178, 60, 240, .45)); transition: transform .35s cubic-bezier(.2, .8, .2, 1.3); }
  .marca:hover .logo-icono { transform: rotate(-8deg) scale(1.06); }
  .marca-texto { display: flex; flex-direction: column; }
  .marca-nombre { white-space: nowrap; }
  .marca-cult { background: linear-gradient(90deg, #c4a6ff, #ff7aa2 55%, #f2c94c); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .marca small { display: block; margin-top: 2px; font-size: 10px; font-weight: 700; color: rgba(255, 255, 255, .5); letter-spacing: .22em; text-transform: uppercase; }
  @media (prefers-reduced-motion: reduce) { .marca:hover .logo-icono { transform: none; } }
  
  .nav-principal { display: flex; gap: 4px; flex-wrap: wrap; }
  .nav-principal a {
    color: rgba(255, 255, 255, .72); font-weight: 600; font-size: 14px;
    padding: 8px 14px; border-radius: 999px; transition: background .15s, color .15s;
  }
  .nav-principal a:hover { color: #fff; background: rgba(255, 255, 255, .08); }
  .nav-principal a.activo { color: #fff; background: rgba(255, 255, 255, .14); }
  
  .acciones-usuario { margin-left: auto; display: flex; align-items: center; gap: 10px; }
  .boton-carrito {
    position: relative; display: inline-flex; align-items: center; gap: 8px;
    color: #fff; font-weight: 600; font-size: 14px; padding: 8px 14px; border-radius: 999px;
    background: rgba(255, 255, 255, .08);
  }
  .boton-carrito:hover { color: #fff; background: rgba(255, 255, 255, .16); }
  .contador {
    min-width: 20px; height: 20px; padding: 0 6px; border-radius: 999px; display: inline-grid; place-items: center;
    background: var(--color-acento); color: #fff; font-size: 11px; font-weight: 800;
  }
  .contador.pop { animation: pop .35s ease-in-out; }
  @keyframes pop { 50% { transform: scale(1.35); } }
  
  .chip-usuario { display: flex; align-items: center; gap: 10px; color: #fff; padding: 4px 6px 4px 4px; border-radius: 999px; }
  .chip-usuario:hover { color: #fff; background: rgba(255, 255, 255, .08); }
  .avatar {
    width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; flex-shrink: 0;
    background: var(--color-marca); color: #fff; font-weight: 800; font-size: 14px; text-transform: uppercase;
  }
  .chip-usuario .nombre { font-size: 13px; font-weight: 700; line-height: 1.2; }
  .chip-usuario .plan { font-size: 11px; color: rgba(255, 255, 255, .6); font-weight: 600; }
  .salir { color: rgba(255, 255, 255, .6); font-size: 13px; font-weight: 600; padding: 8px 10px; }
  .salir:hover { color: #fff; }
  
  .pie { background: var(--color-oscuro); color: rgba(255, 255, 255, .55); font-size: 13px; padding: 28px 0; }
  .pie .contenedor { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .pie a { color: rgba(255, 255, 255, .75); }
  .pie .credito { flex-basis: 100%; text-align: center; padding-top: 14px; border-top: 1px solid rgba(255, 255, 255, .1); font-size: 12px; }
  .pie .credito strong, .credito-panel strong { color: #fff; }
  .credito-panel { margin: 0; font-size: 11px; color: rgba(255, 255, 255, .45); text-align: center; }
  
  /* ---------- Layout: panel de administración ---------- */
  .panel { display: grid; grid-template-columns: 250px 1fr; min-height: 100vh; }
  .lateral {
    background: var(--color-oscuro); color: #fff; padding: 22px 16px;
    position: sticky; top: 0; height: 100vh; overflow-y: auto; display: flex; flex-direction: column; gap: 22px;
  }
  .lateral .marca { padding: 0 8px; }
  .menu-lateral { display: flex; flex-direction: column; gap: 2px; }
  .menu-lateral .titulo-grupo {
    font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em;
    color: rgba(255, 255, 255, .38); padding: 14px 12px 6px;
  }
  .menu-lateral a {
    display: flex; align-items: center; gap: 10px; color: rgba(255, 255, 255, .7);
    font-size: 14px; font-weight: 600; padding: 9px 12px; border-radius: 10px;
  }
  .menu-lateral a:hover { color: #fff; background: rgba(255, 255, 255, .07); }
  .menu-lateral a.activo { color: #fff; background: var(--color-marca); }
  .menu-lateral .icono { width: 20px; text-align: center; }
  .lateral .usuario-panel {
    margin-top: auto; display: flex; align-items: center; gap: 10px; padding: 12px;
    border-radius: 12px; background: rgba(255, 255, 255, .06);
  }
  .usuario-panel .nombre { font-size: 13px; font-weight: 700; }
  .usuario-panel .rol { font-size: 11px; color: rgba(255, 255, 255, .55); font-weight: 600; }
  .usuario-panel .salir { margin-left: auto; padding: 4px; }
  
  .panel-contenido { padding: 30px 36px 60px; min-width: 0; }
  
  /* ---------- Layout: acceso (login / registro) ---------- */
  .acceso { min-height: 100vh; display: grid; grid-template-columns: 1.05fr 1fr; }
  .acceso-arte {
    position: relative; overflow: hidden; color: #fff; padding: 48px;
    display: flex; flex-direction: column; justify-content: space-between;
    background:
      radial-gradient(circle at 20% 20%, rgba(255, 77, 125, .45), transparent 45%),
      radial-gradient(circle at 80% 70%, rgba(91, 61, 245, .7), transparent 50%),
      var(--color-oscuro);
  }
  .acceso-arte h1 { font-size: 40px; max-width: 460px; }
  .acceso-arte p { color: rgba(255, 255, 255, .75); max-width: 420px; font-size: 16px; }
  .acceso-arte .destacados { display: flex; gap: 22px; flex-wrap: wrap; font-size: 14px; color: rgba(255, 255, 255, .8); }
  .acceso-formulario { display: grid; place-items: center; padding: 40px 24px; background: var(--color-superficie); }
  .acceso-formulario .caja { width: 100%; max-width: 500px; }
  
  /* ---------- Encabezado de página ---------- */
  .encabezado-pagina { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 24px; }
  .encabezado-pagina h1 { font-size: 26px; margin-bottom: 4px; }
  .encabezado-pagina p { margin: 0; color: var(--color-texto-suave); }
  .miga { font-size: 13px; color: var(--color-texto-tenue); margin-bottom: 6px; }
  .miga a { color: var(--color-texto-suave); }
  
  /* ---------- Hero de la cartelera ---------- */
  .hero {
    border-radius: 22px; padding: 40px; margin-bottom: 26px; color: #fff; position: relative; overflow: hidden;
    background:
      radial-gradient(circle at 90% 10%, rgba(255, 77, 125, .55), transparent 40%),
      linear-gradient(120deg, var(--color-oscuro-2), var(--color-marca));
  }
  /* Portada con el artista destacado de fondo, del lado derecho y fundido con el degradé */
  .hero.con-foto { isolation: isolate; }
  .hero.con-foto > * { position: relative; z-index: 1; }
  .hero.con-foto::before {
    content: ''; position: absolute; inset: 0 0 0 35%; z-index: 0;
    background-image: var(--foto); background-size: cover; background-position: center 18%;
    filter: grayscale(1) contrast(1.1); mix-blend-mode: luminosity; opacity: .55;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 45%);
    mask-image: linear-gradient(to right, transparent, #000 45%);
  }
  .hero .destacado { display: inline-flex; gap: 6px; align-items: center; font-size: 12px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: rgba(255, 255, 255, .75); margin-bottom: 10px; }
  .hero h1 { font-size: 34px; max-width: 620px; }
  .hero p { color: rgba(255, 255, 255, .8); max-width: 560px; }
  .buscador {
    margin-top: 22px; display: flex; gap: 10px; flex-wrap: wrap; background: #fff; padding: 8px;
    border-radius: 14px; box-shadow: var(--sombra-alta); max-width: 820px;
  }
  .buscador input { border: 0 !important; box-shadow: none !important; background: transparent !important; }
  .buscador .campo-texto { flex: 2; min-width: 200px; }
  .buscador .campo-fecha { flex: 1; min-width: 150px; border-left: 1px solid var(--color-borde); }
  
  /* ---------- Tarjetas y grillas ---------- */
  .tarjeta { background: var(--color-superficie); border: 1px solid var(--color-borde); border-radius: var(--radio); box-shadow: var(--sombra); padding: 24px; }
  .tarjeta + .tarjeta { margin-top: 20px; }
  .tarjeta-titulo { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 16px; flex-wrap: wrap; }
  .tarjeta-titulo h2, .tarjeta-titulo h3 { margin: 0; }
  .tarjeta.estrecha { max-width: 640px; margin-left: auto; margin-right: auto; }
  .tarjeta.media { max-width: 860px; margin-left: auto; margin-right: auto; }
  .seccion-suave { background: var(--color-superficie-2); border: 1px solid var(--color-borde); border-radius: var(--radio-sm); padding: 18px; }
  
  .grilla { display: grid; gap: 20px; }
  .grilla-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .grilla-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .grilla-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .grilla-auto { grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); }
  .grilla-lateral { grid-template-columns: minmax(0, 1fr) 340px; align-items: start; }
  
  /* ---------- Botones ---------- */
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    padding: 10px 18px; border-radius: 10px; border: 1px solid transparent;
    font: inherit; font-size: 14px; font-weight: 700; line-height: 1.2; cursor: pointer; white-space: nowrap;
    background: var(--color-marca); color: #fff; transition: background .15s, transform .05s, box-shadow .15s;
  }
  .btn:hover { background: var(--color-marca-oscuro); color: #fff; }
  .btn:active { transform: translateY(1px); }
  .btn:disabled, .btn.deshabilitado { background: #c5c9d6; border-color: #c5c9d6; color: #fff; cursor: not-allowed; }
  .btn-exito { background: var(--color-exito); }
  .btn-exito:hover { background: #0e8a44; }
  .btn-peligro { background: var(--color-error); }
  .btn-peligro:hover { background: #bf2238; }
  .btn-aviso { background: #f2a516; color: #261a00; }
  .btn-aviso:hover { background: #db9208; color: #261a00; }
  .btn-secundario { background: var(--color-superficie); color: var(--color-texto); border-color: var(--color-borde); }
  .btn-secundario:hover { background: var(--color-superficie-2); color: var(--color-texto); }
  .btn-suave { background: var(--color-marca-suave); color: var(--color-marca-oscuro); }
  .btn-suave:hover { background: #e0d9ff; color: var(--color-marca-oscuro); }
  .btn-peligro-suave { background: var(--color-error-suave); color: var(--color-error); }
  .btn-peligro-suave:hover { background: #fad4da; color: var(--color-error); }
  .btn-chico { padding: 6px 12px; font-size: 13px; border-radius: 8px; }
  .btn-grande { padding: 14px 24px; font-size: 16px; border-radius: 12px; }
  .btn-bloque { width: 100%; }
  .btn-enlace { background: none; border: 0; padding: 0; color: var(--color-texto-suave); font-weight: 700; }
  .btn-enlace:hover { background: none; color: var(--color-texto); }
  form.en-linea { display: inline; margin: 0; }
  
  /* ---------- Formularios ---------- */
  .campo { margin-bottom: 16px; }
  .campo label, label.etiqueta { display: block; font-size: 13px; font-weight: 700; color: var(--color-texto-suave); margin-bottom: 6px; }
  .campo .ayuda { font-size: 12px; color: var(--color-texto-tenue); margin-top: 4px; }
  .campos { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 16px; }
  .campos-3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0 16px; }
  .campo.ancho { grid-column: 1 / -1; }
  input[type=text], input[type=email], input[type=password], input[type=number], input[type=date],
  input[type=time], input[type=search], input[type=tel], select, textarea {
    width: 100%; padding: 11px 13px; font: inherit; font-size: 14px; color: var(--color-texto);
    background: var(--color-superficie); border: 1px solid #d4d8e4; border-radius: 10px;
    transition: border-color .15s, box-shadow .15s;
  }
  input:focus, select:focus, textarea:focus { outline: none; border-color: var(--color-marca); box-shadow: 0 0 0 4px rgba(91, 61, 245, .14); }
  input[readonly], input:disabled { background: var(--color-superficie-2); color: var(--color-texto-suave); }
  textarea { resize: vertical; min-height: 90px; }
  .acciones-formulario { display: flex; gap: 12px; justify-content: flex-end; align-items: center; margin-top: 8px; flex-wrap: wrap; }
  .acciones-formulario.entre { justify-content: space-between; }
  
  /* ---------- Alertas ---------- */
  .alerta { display: flex; gap: 12px; align-items: flex-start; padding: 13px 16px; border-radius: 12px; margin-bottom: 20px; font-size: 14px; font-weight: 600; border: 1px solid transparent; }
  .alerta-exito { background: var(--color-exito-suave); color: #0b6b36; border-color: #bfe9d1; }
  .alerta-error { background: var(--color-error-suave); color: #a51c30; border-color: #f7c4cc; }
  .alerta-aviso { background: var(--color-aviso-suave); color: #8a5300; border-color: #f6dea5; }
  .alerta-info { background: var(--color-info-suave); color: #134f9b; border-color: #c4dbfa; }
  .alerta .acciones { margin-left: auto; display: flex; gap: 8px; flex-wrap: wrap; }
  .alerta-flotante { animation: aparecer .3s ease-out; }
  @keyframes aparecer { from { opacity: 0; transform: translateY(-8px); } }
  
  /* ---------- Tablas ---------- */
  .tabla-contenedor { overflow-x: auto; border: 1px solid var(--color-borde); border-radius: var(--radio-sm); }
  table.tabla { width: 100%; border-collapse: collapse; font-size: 14px; background: var(--color-superficie); }
  .tabla th {
    text-align: left; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em;
    color: var(--color-texto-suave); background: var(--color-superficie-2); padding: 12px 14px; white-space: nowrap;
  }
  .tabla td { padding: 13px 14px; border-top: 1px solid var(--color-borde); vertical-align: middle; }
  .tabla tbody tr:hover { background: #fafbfe; }
  .tabla .acciones-celda { display: flex; gap: 6px; flex-wrap: wrap; }
  .tabla .num { text-align: right; font-variant-numeric: tabular-nums; }
  .tabla tfoot td { font-weight: 700; background: var(--color-superficie-2); }
  
  /* ---------- Insignias ---------- */
  .insignia { display: inline-flex; align-items: center; gap: 4px; padding: 3px 10px; border-radius: 999px; font-size: 12px; font-weight: 700; white-space: nowrap; }
  .insignia-marca { background: var(--color-marca-suave); color: var(--color-marca-oscuro); }
  .insignia-exito { background: var(--color-exito-suave); color: #0b6b36; }
  .insignia-error { background: var(--color-error-suave); color: #a51c30; }
  .insignia-aviso { background: var(--color-aviso-suave); color: #8a5300; }
  .insignia-info { background: var(--color-info-suave); color: #134f9b; }
  .insignia-neutra { background: var(--color-superficie-2); color: var(--color-texto-suave); }
  
  /* ---------- Indicadores (KPI) ---------- */
  .kpi { background: var(--color-superficie); border: 1px solid var(--color-borde); border-radius: var(--radio); padding: 20px; box-shadow: var(--sombra); }
  .kpi .etiqueta-kpi { font-size: 13px; color: var(--color-texto-suave); font-weight: 600; margin-bottom: 6px; }
  .kpi .valor { font-size: 28px; font-weight: 800; letter-spacing: -.02em; }
  .kpi.destacado { background: linear-gradient(135deg, var(--color-marca), #7c5cff); color: #fff; border: 0; }
  .kpi.destacado .etiqueta-kpi { color: rgba(255, 255, 255, .8); }
  .barra { height: 8px; border-radius: 999px; background: var(--color-superficie-2); overflow: hidden; min-width: 80px; }
  .barra span { display: block; height: 100%; background: var(--color-marca); border-radius: inherit; }

  /* Gráfico de barras del informe (recaudación por día) */
  .grafico { overflow-x: auto; overflow-y: hidden; padding: 0 18px; }
  .grafico-barras { display: flex; align-items: flex-end; gap: 4px; height: 200px; min-width: 520px; padding-top: 22px; border-bottom: 1px solid var(--color-borde); }
  .barra-dia {
    position: relative; flex: 1; min-width: 6px; border-radius: 6px 6px 2px 2px; cursor: default;
    background: linear-gradient(180deg, #8b6dff, var(--color-marca)); transition: filter .15s, transform .15s; transform-origin: bottom;
  }
  .barra-dia:hover { filter: brightness(1.15); transform: scaleY(1.02); }
  .barra-dia.hoy { background: linear-gradient(180deg, #ff8fb0, var(--color-acento)); }
  .barra-dia .valor-barra {
    position: absolute; bottom: calc(100% + 4px); left: 50%; transform: translateX(-50%);
    font-size: 10px; font-weight: 700; color: var(--color-texto-suave); white-space: nowrap; opacity: 0; transition: opacity .15s;
  }
  .barra-dia:hover .valor-barra, .barra-dia.hoy .valor-barra { opacity: 1; }
  .grafico-ejes { display: flex; gap: 4px; min-width: 520px; margin-top: 6px; }
  .grafico-ejes span { flex: 1; min-width: 6px; font-size: 10px; color: var(--color-texto-tenue); text-align: center; white-space: nowrap; overflow: visible; }
  .desglose-fila + .desglose-fila { margin-top: 14px; }
  
  /* ---------- Tarjetas de evento ---------- */
  .evento { display: flex; flex-direction: column; background: var(--color-superficie); border: 1px solid var(--color-borde); border-radius: 18px; overflow: hidden; box-shadow: var(--sombra); transition: transform .15s, box-shadow .15s; }
  .evento:hover { transform: translateY(-3px); box-shadow: var(--sombra-alta); }
  /* Al llegar desde el carrusel del inicio (#evento-...), la tarjeta del evento se resalta */
  .evento:target { scroll-margin-top: 90px; animation: resaltarEvento 2.4s ease-out; }
  @keyframes resaltarEvento { 0%, 40% { box-shadow: 0 0 0 4px var(--color-marca), var(--sombra-alta); } 100% { box-shadow: var(--sombra); } }
  .evento-portada { position: relative; height: 150px; padding: 16px; display: flex; flex-direction: column; justify-content: space-between; color: #fff; }
  .evento-portada.tono-0 { background: linear-gradient(135deg, #5b3df5, #ff4d7d); }
  .evento-portada.tono-1 { background: linear-gradient(135deg, #0f766e, #22c55e); }
  .evento-portada.tono-2 { background: linear-gradient(135deg, #1d4ed8, #06b6d4); }
  .evento-portada.tono-3 { background: linear-gradient(135deg, #c2410c, #f59e0b); }
  .evento-portada.tono-4 { background: linear-gradient(135deg, #7e22ce, #ec4899); }
  .evento-portada.tono-5 { background: linear-gradient(135deg, #111827, #6366f1); }
  .fecha-chip { align-self: flex-start; background: rgba(255, 255, 255, .95); color: var(--color-texto); border-radius: 12px; padding: 6px 12px; text-align: center; line-height: 1.1; box-shadow: 0 4px 12px rgba(0, 0, 0, .15); }
  .fecha-chip .dia { display: block; font-size: 22px; font-weight: 800; }
  .fecha-chip .mes { display: block; font-size: 11px; font-weight: 800; text-transform: uppercase; color: var(--color-acento); letter-spacing: .06em; }
  .evento-portada .artista { font-weight: 700; font-size: 13px; text-shadow: 0 1px 4px rgba(0, 0, 0, .3); }

  /* Portada con foto del artista: duotono sobre el degradé + color real al pasar el mouse */
  .evento-portada.con-foto { height: 200px; overflow: hidden; isolation: isolate; }
  .evento-portada.con-foto > * { position: relative; z-index: 3; }
  .evento-portada .portada-foto, .evento-portada .portada-color, .evento-portada .portada-sombra { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
  .evento-portada .portada-foto, .evento-portada .portada-color {
    background-image: var(--foto); background-size: cover; background-position: center 18%;
    transform: scale(1.04); transition: transform .8s cubic-bezier(.2, .7, .2, 1), opacity .5s ease;
  }
  .evento-portada .portada-foto { filter: grayscale(1) contrast(1.15) brightness(1.05); mix-blend-mode: luminosity; }
  .evento-portada .portada-color { opacity: 0; z-index: 1; }
  .evento-portada .portada-sombra { z-index: 2; background: linear-gradient(to top, rgba(18, 16, 31, .85) 0%, rgba(18, 16, 31, .25) 45%, rgba(18, 16, 31, 0) 70%); }
  .evento:hover .portada-foto, .evento:hover .portada-color { transform: scale(1.12); }
  .evento:hover .portada-color { opacity: .92; }
  .evento-portada.con-foto .artista {
    align-self: flex-start; font-size: 14px; padding: 6px 12px; border-radius: 999px;
    background: rgba(255, 255, 255, .16); border: 1px solid rgba(255, 255, 255, .25);
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
  }
  @media (prefers-reduced-motion: reduce) {
    .evento-portada .portada-foto, .evento-portada .portada-color { transition: none; }
    .evento:hover .portada-foto, .evento:hover .portada-color { transform: scale(1.04); }
  }

  /* ---------- Artistas (panel) ---------- */
  .artistas { grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); }
  .tarjeta.artista { padding: 0; overflow: hidden; margin: 0; display: flex; flex-direction: column; }
  .artista-foto { height: 170px; background-size: cover; background-position: center 18%; background-color: var(--color-superficie-2); display: grid; place-items: center; }
  .artista-foto.vacia { background-image: linear-gradient(135deg, var(--color-marca), var(--color-acento)); color: #fff; font-size: 54px; font-weight: 800; text-transform: uppercase; }
  .artista-cuerpo { padding: 16px; display: flex; flex-direction: column; gap: 10px; }
  .alta-artista { display: flex; gap: 20px; align-items: center; flex-wrap: wrap; }
  .alta-artista .artista-foto { width: 120px; height: 120px; border-radius: 16px; flex-shrink: 0; font-size: 44px; }
  .alta-campos { flex: 1; min-width: 260px; }
  .selector-foto {
    display: inline-flex; align-items: center; padding: 9px 14px; border-radius: 10px; cursor: pointer;
    border: 1px dashed #b9b0f5; background: var(--color-marca-suave); color: var(--color-marca-oscuro); font-size: 13px; font-weight: 700; white-space: nowrap;
  }
  .selector-foto:hover { background: #e0d9ff; }
  .selector-foto:focus-within { outline: 3px solid var(--color-marca); outline-offset: 2px; }
  .selector-foto input { position: absolute; width: 1px; height: 1px; opacity: 0; }

  /* Crédito de fotos Creative Commons, discreto sobre la imagen */
  .artista-foto { position: relative; }
  .credito-foto { font-size: 10px; line-height: 1.3; }
  .credito-foto a { color: inherit; text-decoration: underline; text-decoration-color: rgba(255, 255, 255, .4); }
  .evento-portada .credito-foto.sobre-foto, .artista-foto .credito-foto.sobre-foto {
    position: absolute; right: 8px; bottom: 6px; z-index: 4; max-width: 70%; text-align: right;
    color: rgba(255, 255, 255, .78); text-shadow: 0 1px 3px rgba(0, 0, 0, .6);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .evento-portada .credito-foto.sobre-foto { top: 8px; bottom: auto; max-width: 55%; }
  .evento-cuerpo { padding: 18px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
  .evento-cuerpo h3 { margin: 0; font-size: 18px; }
  .evento-meta { display: flex; flex-wrap: wrap; gap: 6px 14px; font-size: 13px; color: var(--color-texto-suave); }
  .evento-descripcion { font-size: 14px; color: var(--color-texto-suave); margin: 0; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .evento-compra { margin-top: auto; border-top: 1px solid var(--color-borde); padding-top: 14px; display: grid; grid-template-columns: 1fr 90px; gap: 10px; align-items: end; }
  .evento-compra .campo { margin: 0; }
  .evento-compra .precio-linea { grid-column: 1 / -1; display: flex; align-items: baseline; justify-content: space-between; }
  .precio { font-size: 22px; font-weight: 800; letter-spacing: -.02em; }
  .precio small { font-size: 12px; font-weight: 600; color: var(--color-texto-tenue); }
  .evento-compra .btn { grid-column: 1 / -1; }
  
  /* ---------- Accesos rápidos ---------- */
  .acceso-rapido { display: flex; gap: 16px; align-items: center; padding: 20px; background: var(--color-superficie); border: 1px solid var(--color-borde); border-radius: var(--radio); box-shadow: var(--sombra); color: var(--color-texto); transition: transform .15s, border-color .15s; }
  .acceso-rapido:hover { transform: translateY(-2px); border-color: var(--color-marca); color: var(--color-texto); }
  .acceso-rapido .icono-grande { width: 48px; height: 48px; border-radius: 14px; display: grid; place-items: center; font-size: 24px; background: var(--color-marca-suave); flex-shrink: 0; }
  .acceso-rapido h4 { margin: 0 0 2px; }
  .acceso-rapido p { margin: 0; font-size: 13px; color: var(--color-texto-suave); }
  
  /* ---------- Entradas (tickets) ---------- */
  /* Entrada estilo "premium": foto del artista difuminada, detalles dorados y talón de papel troquelado */
  :root {
    --oro: #d4af37;
    --oro-claro: #f6e7a6;
    --oro-degrade: linear-gradient(115deg, #a67c00 0%, #f6e7a6 22%, #d4af37 45%, #fff3c4 58%, #b8860b 80%, #f2d675 100%);
    --papel: #fbf6e8;
  }
  .ticket {
    position: relative; display: grid; grid-template-columns: 1fr 190px; border-radius: 18px;
    padding: 2px; background: var(--oro-degrade); box-shadow: 0 14px 34px rgba(18, 16, 31, .22), 0 2px 6px rgba(18, 16, 31, .12);
  }
  .ticket-principal {
    position: relative; overflow: hidden; isolation: isolate; color: #fff;
    border-radius: 16px 0 0 16px; padding: 22px 26px 20px; min-height: 200px;
    background: linear-gradient(120deg, var(--color-oscuro), var(--color-oscuro-2) 55%, #3b2a9b);
    display: flex; flex-direction: column; gap: 10px;
  }
  /* Foto del artista de fondo: difuminada y teñida para que el texto siempre se lea */
  .ticket-principal.con-foto::before {
    content: ''; position: absolute; inset: -12px; z-index: -2;
    background-image: var(--foto); background-size: cover; background-position: center 20%;
    filter: blur(3px) saturate(1.15); transform: scale(1.05);
  }
  .ticket-principal::after {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background:
      linear-gradient(100deg, rgba(18, 16, 31, .96) 0%, rgba(18, 16, 31, .82) 45%, rgba(59, 42, 155, .55) 100%),
      radial-gradient(circle at 100% 0%, rgba(212, 175, 55, .28), transparent 45%);
  }
  .ticket-marca {
    display: flex; justify-content: space-between; align-items: center; gap: 10px;
    font-size: 11px; font-weight: 800; letter-spacing: .22em; text-transform: uppercase;
  }
  .texto-oro { background: var(--oro-degrade); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .ticket-principal h4 { font-size: 24px; font-weight: 800; letter-spacing: -.01em; margin: 6px 0 0; color: #fff; text-shadow: 0 2px 10px rgba(0, 0, 0, .4); }
  .ticket-artista { font-size: 14px; font-weight: 600; color: var(--oro-claro); }
  .ticket-linea { height: 1px; background: linear-gradient(90deg, var(--oro), rgba(212, 175, 55, 0)); opacity: .7; margin: 4px 0; }
  .ticket-datos { display: flex; flex-wrap: wrap; gap: 8px 24px; margin-top: auto; }
  .ticket-datos small { display: block; font-size: 10px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: var(--oro); opacity: .9; }
  .ticket-datos strong { display: block; font-size: 15px; font-weight: 700; color: #fff; white-space: nowrap; }
  .sello-oro {
    display: inline-flex; align-items: center; gap: 6px; padding: 4px 12px; border-radius: 999px;
    border: 1px solid rgba(212, 175, 55, .7); color: var(--oro-claro); background: rgba(212, 175, 55, .12);
    font-size: 11px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase;
  }
  /* Talón: papel crema separado por un troquelado con muescas */
  .ticket-talon {
    position: relative; border-radius: 0 16px 16px 0; padding: 18px 16px;
    background: radial-gradient(circle at 50% 0%, #fffdf6, var(--papel) 70%);
    border-left: 2px dashed rgba(166, 124, 0, .55);
    display: flex; flex-direction: column; justify-content: space-between; align-items: center; gap: 10px; text-align: center; color: #3b2f12;
  }
  .ticket-talon::before, .ticket-talon::after {
    content: ''; position: absolute; left: -13px; width: 24px; height: 24px; border-radius: 50%;
    background: var(--color-fondo); box-shadow: inset 0 0 0 2px var(--oro);
  }
  .ticket-talon::before { top: -14px; } .ticket-talon::after { bottom: -14px; }
  .ticket-talon .qr { width: 128px; padding: 7px; border: 2px solid var(--oro); border-radius: 12px; box-shadow: 0 0 0 4px rgba(212, 175, 55, .18); }
  .ticket-talon .admite { font-size: 10px; font-weight: 800; letter-spacing: .2em; text-transform: uppercase; color: #8a6a00; }
  .ticket-talon .codigo { color: #3b2f12; font-size: 12px; }
  .ticket-talon .btn-cancelar { background: none; border: 0; color: #a51c30; font: inherit; font-size: 12px; font-weight: 700; cursor: pointer; text-decoration: underline; text-underline-offset: 3px; }
  .ticket-talon .btn-cancelar:hover { color: #7d1324; }
  /* Entrada ya validada en la puerta: sello "USADA" */
  .ticket.usada .ticket-principal, .ticket.usada .ticket-talon .qr { filter: grayscale(.85); }
  .ticket .sello-usada {
    position: absolute; top: 46%; left: 58%; transform: translate(-50%, -50%) rotate(-12deg); z-index: 5; pointer-events: none;
    padding: 6px 20px; border: 3px double var(--oro); border-radius: 10px; color: var(--oro-claro);
    font-size: 24px; font-weight: 800; letter-spacing: .3em; text-transform: uppercase; background: rgba(18, 16, 31, .6);
  }
  .codigo { font-family: ui-monospace, 'Cascadia Code', Consolas, monospace; font-weight: 700; font-size: 13px; letter-spacing: .04em; }
  .qr { width: 120px; background: #fff; padding: 6px; border-radius: 10px; border: 1px solid var(--color-borde); }
  .qr svg { display: block; width: 100%; height: auto; }

  /* Paginación */
  .paginacion { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; margin-top: 16px; }
  .paginacion .paginas { display: flex; gap: 6px; flex-wrap: wrap; }
  .lista { display: flex; flex-direction: column; gap: 14px; }
  .item-lista { padding: 14px 16px; border: 1px solid var(--color-borde); border-radius: 12px; background: var(--color-superficie); }
  
  /* ---------- Planes de membresía ---------- */
  .planes { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin-bottom: 22px; }
  .plan { position: relative; cursor: pointer; display: block; }
  .plan input { position: absolute; opacity: 0; }
  .plan-caja { height: 100%; padding: 20px; border: 2px solid var(--color-borde); border-radius: 16px; background: var(--color-superficie); transition: border-color .15s, box-shadow .15s; }
  .plan:hover .plan-caja { border-color: #c9c0ff; }
  .plan input:checked + .plan-caja { border-color: var(--color-marca); box-shadow: 0 0 0 4px rgba(91, 61, 245, .12); }
  .plan input:focus-visible + .plan-caja { outline: 3px solid var(--color-marca); outline-offset: 2px; }
  .plan-caja .nombre-plan { font-weight: 800; font-size: 17px; }
  .plan-caja .precio-plan { font-size: 26px; font-weight: 800; margin: 8px 0; }
  .plan-caja .precio-plan small { font-size: 13px; color: var(--color-texto-tenue); font-weight: 600; }
  .plan-caja p { font-size: 13px; color: var(--color-texto-suave); margin: 0; }
  .plan-actual { position: absolute; top: -10px; right: 14px; }
  
  /* ---------- Resumen de compra ---------- */
  .resumen { display: flex; flex-direction: column; gap: 10px; }
  .resumen .linea { display: flex; justify-content: space-between; font-size: 14px; color: var(--color-texto-suave); }
  .resumen .total { display: flex; justify-content: space-between; align-items: baseline; border-top: 1px solid var(--color-borde); padding-top: 12px; font-weight: 800; font-size: 16px; }
  .resumen .total .precio { color: var(--color-texto); }
  
  /* ---------- Estado vacío ---------- */
  .vacio { text-align: center; padding: 48px 20px; color: var(--color-texto-suave); }
  .vacio .icono-vacio { font-size: 44px; margin-bottom: 8px; }
  
  /* ---------- Detalles desplegables ---------- */
  details summary { cursor: pointer; color: var(--color-marca); font-weight: 700; font-size: 13px; }
  details[open] summary { margin-bottom: 8px; }
  
  /* ---------- Comprobante / ticket impreso ---------- */
  .comprobante { max-width: 680px; margin: 0 auto; }
  .comprobante-cabecera { padding: 26px; border-radius: var(--radio) var(--radio) 0 0; background: linear-gradient(120deg, var(--color-exito), #34d399); color: #fff; }
  .comprobante-cabecera h1 { font-size: 24px; margin: 0; }
  .comprobante-cuerpo { background: var(--color-superficie); border: 1px solid var(--color-borde); border-top: 0; border-radius: 0 0 var(--radio) var(--radio); padding: 26px; box-shadow: var(--sombra); }
  .datos-lista { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px 20px; margin-bottom: 20px; }
  .datos-lista .dato small { display: block; font-size: 12px; color: var(--color-texto-tenue); font-weight: 600; }
  .datos-lista .dato strong { font-size: 14px; }
  
  /* ---------- Responsive ---------- */
  @media (max-width: 960px) {
    .panel { grid-template-columns: 1fr; }
    .lateral { position: static; height: auto; padding: 14px 16px; gap: 10px; }
    .menu-lateral { flex-direction: row; overflow-x: auto; gap: 4px; padding-bottom: 4px; scrollbar-width: none; }
    .menu-lateral::-webkit-scrollbar, .nav-principal::-webkit-scrollbar { display: none; }
    .nav-principal { scrollbar-width: none; }
    .menu-lateral .titulo-grupo { display: none; }
    .menu-lateral a { white-space: nowrap; }
    .lateral .usuario-panel { margin-top: 0; }
    .panel-contenido { padding: 22px 16px 48px; }
    .grilla-3, .grilla-4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .grilla-lateral { grid-template-columns: 1fr; }
    .acceso { grid-template-columns: 1fr; }
    .acceso-arte { padding: 32px 24px; }
    .acceso-arte h1 { font-size: 30px; }
    .acceso-arte .destacados { display: none; }
  }
  @media (max-width: 720px) {
    body { font-size: 14px; }
    .contenedor { padding: 0 16px; }
    .encabezado .contenedor { gap: 10px; padding-top: 10px; padding-bottom: 10px; }
    .nav-principal { order: 3; width: 100%; overflow-x: auto; flex-wrap: nowrap; }
    .nav-principal a { white-space: nowrap; }
    .chip-usuario .texto-chip { display: none; }
    .hero { padding: 26px 20px; border-radius: 16px; }
    .hero h1 { font-size: 26px; }
    .buscador .campo-fecha { border-left: 0; border-top: 1px solid var(--color-borde); }
    .grilla-2, .grilla-3, .grilla-4, .campos, .campos-3, .planes, .datos-lista { grid-template-columns: 1fr; }
    .tarjeta { padding: 18px; }
    .ticket { grid-template-columns: 1fr; }
    .ticket-principal { border-radius: 16px 16px 0 0; padding: 20px; }
    .ticket-principal h4 { font-size: 21px; }
    .ticket-talon { border-radius: 0 0 16px 16px; border-left: 0; border-top: 2px dashed rgba(166, 124, 0, .55); flex-direction: row; flex-wrap: wrap; justify-content: center; }
    .ticket-talon::before, .ticket-talon::after { top: -13px; bottom: auto; }
    .ticket-talon::before { left: -13px; } .ticket-talon::after { left: auto; right: -13px; }
    .ticket .sello-usada { left: 50%; top: 35%; }
    .encabezado-pagina h1 { font-size: 22px; }
  }
  
  /* ---------- Impresión ---------- */
  @media print {
    .encabezado, .pie, .lateral, .no-imprimir { display: none !important; }
    body { background: #fff; }
    .panel { display: block; }
    .tarjeta, .comprobante-cuerpo { box-shadow: none; }
  }
