//- Campos compartidos por "Crear personal" y "Editar usuario".
//- u: datos a precargar · conPassword: muestra el campo de contraseña (solo al crear)
mixin camposUsuario(u, conPassword)
  - u = u || {}
  - const soloLetras = "return (event.charCode >= 65 && event.charCode <= 90) || (event.charCode >= 97 && event.charCode <= 122) || event.charCode === 32 || event.charCode === 209 || event.charCode === 241"
  - const soloNumeros = 'return event.charCode >= 48 && event.charCode <= 57'
  - const fechaNac = u.fechaNacimiento ? new Date(u.fechaNacimiento).toISOString().split('T')[0] : ''
  - const maxFecha = new Date(new Date().setFullYear(new Date().getFullYear() - 18)).toISOString().split('T')[0]

  .campos
    .campo
      label(for="nombreUsuario") Nombre de usuario
      input#nombreUsuario(type="text" name="nombreUsuario" value=u.nombreUsuario required)
    .campo
      label(for="email") Correo electrónico
      input#email(type="email" name="email" value=u.email required placeholder="ejemplo@correo.com")
    .campo
      label(for="nombre") Nombre
      input#nombre(type="text" name="nombre" value=u.nombre required pattern="[A-Za-zÁÉÍÓÚáéíóúÑñ\\s]+" title="Solo letras y espacios" onkeypress=soloLetras)
    .campo
      label(for="apellido") Apellido
      input#apellido(type="text" name="apellido" value=u.apellido required pattern="[A-Za-zÁÉÍÓÚáéíóúÑñ\\s]+" title="Solo letras y espacios" onkeypress=soloLetras)
    if conPassword
      .campo.ancho
        label(for="password") Contraseña
        input#password(type="password" name="password" required autocomplete="new-password")
    .campo
      label(for="dni") DNI
      input#dni(type="text" name="dni" value=u.dni required pattern="\\d{7,8}" title="7 u 8 números" minlength="7" maxlength="8" inputmode="numeric" onkeypress=soloNumeros)
    .campo
      label(for="telefono") Teléfono
      input#telefono(type="text" name="telefono" value=u.telefono required pattern="\\d{10,15}" title="Entre 10 y 15 números" minlength="10" maxlength="15" inputmode="numeric" onkeypress=soloNumeros)
    .campo
      label(for="fechaNacimiento") Fecha de nacimiento
      input#fechaNacimiento(type="date" name="fechaNacimiento" value=fechaNac required min="1900-01-01" max=maxFecha)
    .campo
      label(for="rol") Rol del sistema
      select#rol(name="rol")
        each rol in ['Cliente', 'Administrador', 'Supervisor', 'Lector']
          option(value=rol selected=(u.rol === rol))= rol
    .campo
      label(for="tipoCliente") Tipo de cliente
      select#tipoCliente(name="tipoCliente")
        each tipo in ['ESTANDAR', 'PREMIUM', 'VIP']
          option(value=tipo selected=(u.tipoCliente === tipo))= tipo
