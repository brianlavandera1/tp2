    case nombre
      when 'inicio'
        path(d="M3 11 12 3l9 8M5 9.5V21h14V9.5M10 21v-6h4v6")
      when 'cartelera'
        path(d="M5 3h14v18H5zM5 9h14M9 13h6M9 17h6")
      when 'entrada'
        path(d="M3 7h18v3.5a1.5 1.5 0 0 0 0 3V17H3v-3.5a1.5 1.5 0 0 0 0-3zM14 7v2M14 11v2M14 15v2")
      when 'plan'
        path(d="m12 3 2.7 5.6 6.1.8-4.4 4.3 1 6.1L12 17l-5.4 2.8 1-6.1-4.4-4.3 6.1-.8z")
      when 'perfil'
        path(d="M12 12a4.5 4.5 0 1 0 0-9 4.5 4.5 0 0 0 0 9zM4 21c1-4 4-6 8-6s7 2 8 6")
      when 'carrito'
        path(d="M3 4h2.5l2.4 11h10.3L20.5 7H6.4M9.5 20a1 1 0 1 0 0-2 1 1 0 0 0 0 2zM17 20a1 1 0 1 0 0-2 1 1 0 0 0 0 2z")
      when 'validar'
        path(d="M4 8V4h4M16 4h4v4M20 16v4h-4M8 20H4v-4M8 8h3v3H8zM13 13h3v3h-3zM13 8h3M8 16h3")
      when 'sala'
        path(d="M3 21h18M5 21V9l7-5 7 5v12M9 21v-6h6v6M9 11h.01M15 11h.01")
      when 'artista'
        path(d="M12 3a3 3 0 0 0-3 3v5a3 3 0 0 0 6 0V6a3 3 0 0 0-3-3zM5 11a7 7 0 0 0 14 0M12 18v3M9 21h6")
      when 'informe'
        path(d="M4 20V4M4 20h16M8 16v-5M12 16V8M16 16v-3")
      when 'pagos'
        path(d="M3 6h18v12H3zM3 10h18M7 15h3")
      when 'cancelar'
        path(d="M9 7 4 12l5 5M4 12h11a5 5 0 0 1 0 10h-2")
      when 'usuarios'
        path(d="M9 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7zM3 20c.7-3.4 3-5 6-5s5.3 1.6 6 5M16 4.3a3.5 3.5 0 0 1 0 6.4M18 15.4c1.5.8 2.6 2.3 3 4.6")
