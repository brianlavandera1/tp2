extends ../layoutCliente.pug

block titulo
  | Comprobante · Urbana Cult

block content
  .comprobante
    .comprobante-cabecera
      .fila-entre
        div
          h1 ✅ ¡Pago aprobado!
          p.mb-0 Tus entradas ya están disponibles en “Mis entradas”.
        span.insignia(style="background:rgba(255,255,255,.2);color:#fff") #{transaccion.comprobanteId}

    .comprobante-cuerpo
      .datos-lista
        .dato
          small Cliente
          strong= transaccion.nombreCliente
        .dato
          small Fecha
          strong= new Date(transaccion.fechaCompra).toLocaleString('es-AR')
        .dato
          small Medio de pago
          strong #{transaccion.medioPago} (•••• #{transaccion.tarjetaUltimosDigitos})
        .dato
          small Comprobante
          strong.codigo= transaccion.comprobanteId

      .tabla-contenedor
        table.tabla
          thead
            tr
              th Evento
              th Sector
              th.num Cant.
              th.num Subtotal
          tbody
            each item in transaccion.items
              tr
                td.negrita= item.nombreEvento
                td= item.tipoEntrada
                td.num= item.cantidad
                td.num $#{(item.precio * item.cantidad).toLocaleString('es-AR')}

      .resumen.mt
        .linea
          span Subtotal
          span $#{transaccion.subtotal.toLocaleString('es-AR')}
        if transaccion.descuentoAplicado > 0
          .linea.texto-exito
            span Descuento por membresía
            span −$#{transaccion.descuentoAplicado.toLocaleString('es-AR')}
        .total
          span Total abonado
          span.precio $#{transaccion.total.toLocaleString('es-AR')}

      .acciones-formulario.mt.no-imprimir
        button.btn.btn-secundario(type="button" onclick="window.print()") 🖨️ Imprimir
        a.btn(href="/cliente/mis-compras") Ver mis entradas
