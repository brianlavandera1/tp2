extends ../layoutCliente.pug

block titulo
  | Comprobante · Urbana Cult

block content
  .comprobante
    .comprobante-cuerpo
      h1 ¡Listo! Ya tenés tus entradas
      p.texto-suave #{transaccion.comprobanteId} · #{new Date(transaccion.fechaCompra).toLocaleString('es-AR')}

      .tabla-contenedor
        table.tabla
          tbody
            each item in transaccion.items
              tr
                td
                  strong= item.nombreEvento
                  br
                  span.texto-tenue #{item.tipoEntrada} · #{item.cantidad} #{item.cantidad === 1 ? 'entrada' : 'entradas'}
                td.num $#{(item.precio * item.cantidad).toLocaleString('es-AR')}

      - const nombrePlan = { PREMIUM: 'Premium', VIP: 'VIP' }[usuarioLogueado.tipoCliente] || 'Estándar'
      .resumen.mt
        if transaccion.descuentoAplicado > 0
          .linea
            span Precio original
            span $#{transaccion.subtotal.toLocaleString('es-AR')}
          .linea
            span Descuento plan #{nombrePlan} (#{Math.round(transaccion.descuentoAplicado / transaccion.subtotal * 100)}%)
            span −$#{transaccion.descuentoAplicado.toLocaleString('es-AR')}
        .total
          span Precio final · #{transaccion.medioPago} (•••• #{transaccion.tarjetaUltimosDigitos})
          span.precio $#{transaccion.total.toLocaleString('es-AR')}

      .acciones-formulario.mt.no-imprimir
        button.btn.btn-secundario(type="button" onclick="window.print()") Imprimir
        a.btn(href="/cliente/mis-compras") Ver mis entradas

  style.
    .comprobante { max-width: 620px; margin: 0 auto; }
    .comprobante-cuerpo h1, .comprobante-cuerpo > p { text-align: center; }
    .comprobante-cuerpo { border: 0; border-radius: var(--radio); background: var(--color-superficie); padding: 28px; }
    .comprobante-cuerpo h1 { font-size: 26px; margin-bottom: 4px; }
    .comprobante .tabla td { padding-left: 0; padding-right: 0; }
    .comprobante .tabla tr:first-child td { border-top: 0; }
    .comprobante .tabla { margin-top: 10px; }
    @media print { .comprobante-cuerpo { background: #fff; padding: 0; } }
