extends ../layoutCliente.pug
include ../partials/password.pug
include ../partials/plan.pug

block titulo
  | Mi perfil · Urbana Cult

block content
  .tarjeta.estrecha
    .fila(style="margin-bottom:22px")
      span.avatar(style="width:52px;height:52px;font-size:20px")= usuario.nombreUsuario.charAt(0)
      div
        h1(style="font-size:22px;margin:0") #{usuario.nombre} #{usuario.apellido}
        span.texto-suave @#{usuario.nombreUsuario}

    +avisoPlan(usuario)

    if mensajeExito
      .alerta.alerta-exito #{mensajeExito}
    if error
      .alerta.alerta-error(role="alert") #{error}

    form(action="/cliente/configuracion" method="POST")
      .campos
        .campo
          label(for="nombre") Nombre
          input#nombre(type="text" name="nombre" value=usuario.nombre required onkeypress="return (event.charCode >= 65 && event.charCode <= 90) || (event.charCode >= 97 && event.charCode <= 122) || event.charCode === 32 || event.charCode === 209 || event.charCode === 241")
        .campo
          label(for="apellido") Apellido
          input#apellido(type="text" name="apellido" value=usuario.apellido required onkeypress="return (event.charCode >= 65 && event.charCode <= 90) || (event.charCode >= 97 && event.charCode <= 122) || event.charCode === 32 || event.charCode === 209 || event.charCode === 241")

      .campos
        .campo
          label(for="email") Correo electrónico
          input#email(type="email" name="email" value=usuario.email required)
        .campo
          label(for="telefono") Teléfono
          input#telefono(type="text" name="telefono" value=usuario.telefono required minlength="10" maxlength="15" inputmode="numeric" onkeypress="return event.charCode >= 48 && event.charCode <= 57")

      .campo
        label(for="nuevaPassword") Nueva contraseña (opcional)
        +campoPassword()(id="nuevaPassword" name="nuevaPassword" placeholder="••••••••" autocomplete="new-password")

      button.btn.btn-bloque.btn-grande(type="submit") Guardar cambios

    a.ayuda-perfil(href="/ayuda") Centro de ayuda
    a.salir-perfil(href="/auth/logout") Cerrar sesión

  style.
    .salir-perfil { display: block; margin-top: 10px; padding: 13px; border: 1px solid rgba(255, 143, 163, .45); border-radius: 12px; background: rgba(255, 143, 163, .1); color: #ffb3c1; font-size: 15px; font-weight: 600; text-align: center; }
    .ayuda-perfil { display: block; margin-top: 14px; padding: 13px; border: 1px solid var(--color-borde); border-radius: 12px; color: #fff; font-size: 15px; font-weight: 600; text-align: center; }
    .ayuda-perfil:hover { background: var(--color-superficie-2); color: #fff; }
    .salir-perfil:hover { background: rgba(255, 143, 163, .2); color: #fff; }
