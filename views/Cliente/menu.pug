extends ../layoutCliente.pug
include ../partials/creditoFoto.pug

block titulo
  | Inicio · Urbana Cult

block content
  - const meses = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic']
  - const plata = (n) => `$${Number(n).toLocaleString('es-AR')}`
  - const fotoDe = (ev) => (ev.entidad ? ev.entidad.urlFoto : null)
  - const enlace = (ev) => `/cliente/comprar#evento-${ev._id}`

  //- GRAN PANTALLA: la foto a todo el ancho; cambia sola y la línea de tiempo marca cuándo
  if destacados && destacados.length
    section.pantalla(aria-roledescription="carrusel" aria-label="Nuevos eventos")
      each d, i in destacados
        - const urlFoto = fotoDe(d.evento)
        .foto-evento(class=(i === 0 ? 'activa' : '') style=urlFoto ? `background-image:url('${urlFoto}')` : undefined)
      if destacados.length > 1
        .linea-tiempo(aria-hidden="true")
          each d, i in destacados
            span.tramo(class=(i === 0 ? 'activo' : ''))
              i
        button.flecha-foto.anterior(type="button" aria-label="Evento anterior") ‹
        button.flecha-foto.siguiente(type="button" aria-label="Evento siguiente") ›
      .pantalla-texto
        .textos-pila
          each d, i in destacados
            - const ev = d.evento
            - const fecha = new Date(ev.fecha)
            article.texto-evento(class=(i === 0 ? 'activo' : '') aria-hidden=(i === 0 ? 'false' : 'true'))
              p.saludo Hola, #{usuarioLogueado.nombreUsuario}
              p.datos-evento #{d.esNuevo ? 'Nuevo en cartelera · ' : ''}#{fecha.getDate()} #{meses[fecha.getMonth()]} · #{ev.hora || '21:00'} hs#{ev.sala ? ` · ${ev.sala.nombre}` : ''}
              h1= ev.nombre
              .compra
                a.btn.btn-grande.btn-comprar(href=enlace(ev) tabindex=(i === 0 ? 0 : -1)) Comprar entradas
                span.precio-desde
                  small Desde
                  strong= plata(d.desdeConDescuento)
                if fotoDe(ev)
                  +creditoFoto(ev.entidad.fotoCredito, 'credito-pantalla')
  else
    .tarjeta.vacio
      h3 Pronto, los próximos shows
      a.btn.mt(href="/cliente/comprar") Ver cartelera

  if mensajeExito
    .alerta.alerta-exito.mt #{mensajeExito}

  //- SE ESTÁN AGOTANDO: datos reales del stock de cada evento
  if seAgotan && seAgotan.length
    section.agotan(class=(destacados && destacados.length ? 'sobre-pantalla' : '') aria-label="Se están agotando")
      each d in seAgotan
        - const ev = d.evento
        - const fecha = new Date(ev.fecha)
        a.agota(href=enlace(ev))
          span.agota-foto(style=fotoDe(ev) ? `background-image:url('${fotoDe(ev)}')` : undefined)
          span.agota-texto
            span.quedan Quedan #{ev.entradasDisponibles} #{ev.entradasDisponibles === 1 ? 'entrada' : 'entradas'}
            strong= ev.nombre
            span.barra-stock
              i(style=`width:${d.ocupacion}%`)
            span.agota-pie #{fecha.getDate()} #{meses[fecha.getMonth()]} · desde #{plata(d.desdeConDescuento)}

  //- TU PRÓXIMA SALIDA
  if proximaSalida
    a.proxima(href="/cliente/mis-compras")
      span.proxima-dias
        strong= proximaSalida.dias
        span #{proximaSalida.dias === 1 ? 'día' : 'días'}
      span.proxima-texto
        small Tu próxima salida
        strong= proximaSalida.evento.nombre
      span.proxima-ver Ver mis entradas →

  //- LO QUE VIENE
  if loQueViene && loQueViene.length
    section.viene
      .viene-titulo
        h2 Lo que viene
        a(href="/cliente/comprar") Ver toda la cartelera →
      .viene-fila
        each d in loQueViene
          - const ev = d.evento
          - const fecha = new Date(ev.fecha)
          a.viene-evento(href=enlace(ev))
            span.viene-foto(style=fotoDe(ev) ? `background-image:url('${fotoDe(ev)}')` : undefined)
              span.viene-fecha #{fecha.getDate()} #{meses[fecha.getMonth()]}
            span.viene-texto
              strong= ev.nombre
              span #{ev.sala ? `${ev.sala.nombre} · ` : ''}#[b= plata(d.desdeConDescuento)]

  //- PLAN: solo a quien todavía puede subir
  if usuarioCompleto && usuarioCompleto.tipoCliente !== 'VIP'
    a.franja-plan(href="/cliente/membresia")
      span
        strong Con el plan VIP, cada entrada te sale menos
        small Mirá cuánto ahorrás con lo que salís por año.
      span.franja-boton Ver planes

  style.
    .sitio main { padding-top: 0; }

    /* Gran pantalla */
    .pantalla { position: relative; isolation: isolate; display: flex; align-items: flex-end; width: calc(100vw - var(--barra, 0px)); min-height: min(78vh, 620px); margin-left: calc(50% - 50vw + var(--barra, 0px) / 2); overflow: hidden; background: linear-gradient(135deg, #2c2257, #5a2a8a 60%, #8a2f78); }
    .foto-evento { position: absolute; inset: 0; z-index: -2; background: center 15% / cover no-repeat; opacity: 0; visibility: hidden; transition: opacity .8s, visibility .8s; }
    .foto-evento.activa { opacity: 1; visibility: visible; animation: acercar 6s ease-out forwards; }
    @keyframes acercar { from { transform: scale(1.07); } to { transform: scale(1); } }
    .pantalla::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(to top, #110d1f 3%, rgba(17, 13, 31, .72) 36%, rgba(17, 13, 31, .05) 72%), linear-gradient(90deg, rgba(17, 13, 31, .7), rgba(17, 13, 31, 0) 60%), linear-gradient(to bottom, rgba(17, 13, 31, .55), rgba(17, 13, 31, 0) 18%); }

    /* Línea de tiempo: el tramo activo se llena en lo que dura la foto */
    .linea-tiempo { position: absolute; top: 14px; left: max(20px, calc(50% - var(--ancho-max) / 2 + 20px)); right: max(20px, calc(50% - var(--ancho-max) / 2 + 20px)); display: flex; gap: 6px; }
    .tramo { flex: 1; height: 4px; border-radius: 4px; overflow: hidden; background: rgba(255, 255, 255, .32); }
    .tramo i { display: block; height: 100%; width: 0; border-radius: 4px; background: #fff; }
    .tramo.hecho i { width: 100%; }
    .tramo.activo i { animation: llenar 6s linear forwards; }
    .pantalla-pausada .tramo.activo i, .pantalla-pausada .foto-evento.activa { animation-play-state: paused; }
    @keyframes llenar { to { width: 100%; } }

    .flecha-foto { position: absolute; top: 42%; z-index: 2; width: 46px; height: 46px; border: 1px solid rgba(255, 255, 255, .3); border-radius: 50%; background: rgba(17, 13, 31, .55); color: #fff; font-size: 24px; line-height: 1; cursor: pointer; backdrop-filter: blur(4px); transition: background .15s; }
    .flecha-foto:hover { background: rgba(17, 13, 31, .85); }
    .flecha-foto.anterior { left: 16px; }
    .flecha-foto.siguiente { right: 16px; }

    .pantalla-texto { width: 100%; max-width: var(--ancho-max); margin: 0 auto; padding: 90px 20px 92px; }
    .saludo { margin: 0 0 4px; color: #e6e1f5; font-size: 14px; }
    .textos-pila { display: grid; }
    .texto-evento { grid-area: 1 / 1; align-self: end; opacity: 0; visibility: hidden; transform: translateY(10px); transition: opacity .45s, transform .45s, visibility .45s; }
    .texto-evento.activo { opacity: 1; visibility: visible; transform: none; }
    .datos-evento { margin: 0 0 8px; color: var(--enlace); font-weight: 600; }
    .texto-evento h1 { max-width: 900px; margin: 0 0 18px; font-size: clamp(38px, 6.2vw, 76px); line-height: 1; letter-spacing: -.04em; text-wrap: balance; }
    .compra { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 22px; }
    .precio-desde { display: grid; line-height: 1.1; }
    .precio-desde small { color: var(--color-texto-suave); font-size: 13px; }
    .precio-desde strong { font-size: 24px; font-weight: 600; letter-spacing: -.03em; }
    .credito-pantalla { margin-left: auto; color: rgba(255, 255, 255, .75); text-shadow: 0 1px 3px rgba(0, 0, 0, .7); }

    /* Se están agotando */
    .agotan { position: relative; z-index: 3; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 14px; margin-top: 18px; }
    .agotan.sobre-pantalla { margin-top: -62px; }
    .agota { display: grid; grid-template-columns: 84px minmax(0, 1fr); gap: 14px; padding: 12px; border: 1px solid var(--color-borde); border-radius: 18px; background: var(--color-superficie); color: #fff; transition: background .15s; }
    .agota:hover { background: var(--color-superficie-2); color: #fff; }
    .agota-foto { min-height: 100px; border-radius: 12px; background: linear-gradient(135deg, #2c2257, #8a2f78) center 22% / cover no-repeat; }
    .agota-texto { display: flex; flex-direction: column; justify-content: center; min-width: 0; gap: 4px; }
    .agota-texto strong { font-size: 15px; font-weight: 600; line-height: 1.2; }
    .quedan { color: var(--color-aviso); font-size: 12px; font-weight: 600; }
    .barra-stock { height: 6px; margin-top: 4px; border-radius: 6px; overflow: hidden; background: rgba(255, 255, 255, .14); }
    .barra-stock i { display: block; height: 100%; border-radius: 6px; background: var(--color-aviso); }
    .agota-pie { color: var(--color-texto-suave); font-size: 12px; }

    /* Tu próxima salida */
    .proxima { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 16px; margin-top: 14px; padding: 12px 20px; border: 1px solid var(--color-borde); border-radius: 18px; background: var(--color-superficie); color: #fff; }
    .proxima:hover { background: var(--color-superficie-2); color: #fff; }
    .proxima-dias { display: flex; align-items: baseline; gap: 5px; color: var(--color-texto-suave); font-size: 13px; }
    .proxima-dias strong { color: #fff; font-size: 30px; font-weight: 700; letter-spacing: -.04em; }
    .proxima-texto { display: grid; min-width: 0; line-height: 1.25; }
    .proxima-texto small { color: var(--color-texto-suave); font-size: 13px; }
    .proxima-texto strong { font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .proxima-ver { color: var(--enlace); font-size: 14px; font-weight: 500; white-space: nowrap; }

    /* Lo que viene */
    .viene { margin-top: 30px; }
    .viene-titulo { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
    .viene-titulo h2 { margin: 0; font-size: 22px; }
    .viene-titulo a { font-size: 14px; font-weight: 500; white-space: nowrap; }
    .viene-fila { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
    .viene-evento { border: 1px solid var(--color-borde); border-radius: 18px; overflow: hidden; background: var(--color-superficie); color: #fff; transition: background .15s, transform .15s; }
    .viene-evento:hover { background: var(--color-superficie-2); color: #fff; transform: translateY(-3px); }
    .viene-foto { position: relative; display: block; height: 170px; background: linear-gradient(135deg, #2c2257, #5a2a8a 60%, #8a2f78) center 22% / cover no-repeat; }
    .viene-fecha { position: absolute; top: 10px; left: 10px; padding: 6px 10px; border-radius: 10px; background: rgba(17, 13, 31, .82); font-size: 13px; font-weight: 600; }
    .viene-texto { display: grid; gap: 4px; padding: 12px 14px; }
    .viene-texto strong { font-size: 15px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .viene-texto span { color: var(--color-texto-suave); font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .viene-texto b { color: #fff; font-weight: 600; }

    /* Plan */
    .franja-plan { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-top: 30px; padding: 22px 30px; border-radius: 22px; background: linear-gradient(120deg, #33286a, #5a2a8a 70%, #8a2f78); color: #fff; }
    .franja-plan:hover { color: #fff; }
    .franja-plan strong { display: block; font-size: 22px; font-weight: 600; line-height: 1.2; }
    .franja-plan small { display: block; margin-top: 4px; color: #e6e1f5; font-size: 14px; }
    .franja-boton { flex: none; padding: 12px 26px; border-radius: 999px; background: #fff; color: #1d1833; font-weight: 600; font-size: 14px; }

    @media (max-width: 960px) {
      .viene-fila { grid-auto-flow: column; grid-template-columns: none; grid-auto-columns: 230px; overflow-x: auto; padding-bottom: 8px; scrollbar-width: none; }
      .viene-fila::-webkit-scrollbar { display: none; }
    }
    @media (max-width: 720px) {
      .pantalla { min-height: 70vh; }
      .pantalla-texto { padding: 70px 16px 66px; }
      .linea-tiempo { left: 16px; right: 16px; }
      .flecha-foto { top: 52px; width: 38px; height: 38px; font-size: 20px; }
      .flecha-foto.anterior { left: 10px; }
      .flecha-foto.siguiente { right: 10px; }
      .credito-pantalla { width: 100%; margin-left: 0; }
      .agotan.sobre-pantalla { margin-top: -34px; }
      .proxima { grid-template-columns: auto minmax(0, 1fr); }
      .proxima-ver { display: none; }
      .franja-plan { flex-direction: column; align-items: flex-start; padding: 20px; }
      .franja-plan strong { font-size: 19px; }
    }
    @media (prefers-reduced-motion: reduce) {
      .texto-evento, .foto-evento { transition: none; }
      .foto-evento.activa { animation: none; }
    }

  script.
    (() => {
      const pantalla = document.querySelector('.pantalla');
      if (!pantalla) return;
      // 100vw incluye la barra de desplazamiento: se descuenta para que el texto quede alineado con el resto
      pantalla.style.setProperty('--barra', `${innerWidth - document.documentElement.clientWidth}px`);
      const textos = [...pantalla.querySelectorAll('.texto-evento')];
      const fotos = [...pantalla.querySelectorAll('.foto-evento')];
      const tramos = [...pantalla.querySelectorAll('.tramo')];
      if (textos.length < 2) return;

      const DURACION = 6000; // igual que las animaciones de la foto y de la línea de tiempo
      let actual = 0, espera = null, inicio = 0, restante = DURACION;

      const programar = () => {
        clearTimeout(espera);
        espera = null;
        if (pantalla.classList.contains('pantalla-pausada')) return;
        inicio = Date.now();
        espera = setTimeout(() => ir(actual + 1), restante);
      };

      const ir = (n) => {
        actual = (n + textos.length) % textos.length;
        textos.forEach((t, i) => {
          const visible = i === actual;
          t.classList.toggle('activo', visible);
          t.setAttribute('aria-hidden', String(!visible));
          t.querySelector('.btn-comprar').tabIndex = visible ? 0 : -1;
        });
        fotos.forEach((f, i) => f.classList.toggle('activa', i === actual));
        tramos.forEach((t, i) => {
          t.classList.toggle('hecho', i < actual);
          t.classList.toggle('activo', i === actual);
        });
        restante = DURACION;
        programar();
      };

      // Espera mientras el cliente está por tocar Comprar o navega con el teclado, y sigue donde quedó
      const pausar = () => {
        if (espera) restante = Math.max(0, restante - (Date.now() - inicio));
        clearTimeout(espera);
        espera = null;
        pantalla.classList.add('pantalla-pausada');
      };
      const seguir = () => {
        if (!pantalla.classList.contains('pantalla-pausada')) return;
        pantalla.classList.remove('pantalla-pausada');
        programar();
      };

      pantalla.querySelector('.flecha-foto.anterior').addEventListener('click', () => ir(actual - 1));
      pantalla.querySelector('.flecha-foto.siguiente').addEventListener('click', () => ir(actual + 1));
      // Flechas del teclado, salvo que se esté escribiendo en un campo o con una ventana abierta
      document.addEventListener('keydown', (e) => {
        if (e.altKey || e.ctrlKey || e.metaKey || e.target.matches('input, textarea, select') || document.querySelector('dialog[open]')) return;
        if (e.key === 'ArrowLeft') ir(actual - 1);
        if (e.key === 'ArrowRight') ir(actual + 1);
      });

      pantalla.querySelectorAll('.compra').forEach((zona) => {
        // Solo con mouse: en el celular no hay un "salir" que lo vuelva a poner en marcha
        zona.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') pausar(); });
        zona.addEventListener('pointerleave', (e) => { if (e.pointerType === 'mouse') seguir(); });
      });
      pantalla.addEventListener('focusin', (e) => { if (e.target.matches(':focus-visible')) pausar(); });
      pantalla.addEventListener('focusout', seguir);
      document.addEventListener('visibilitychange', () => (document.hidden ? pausar() : seguir()));

      // Deslizar con el dedo
      let inicioX = null;
      pantalla.addEventListener('touchstart', (e) => { inicioX = e.touches[0].clientX; }, { passive: true });
      pantalla.addEventListener('touchend', (e) => {
        if (inicioX === null) return;
        const dx = e.changedTouches[0].clientX - inicioX;
        if (Math.abs(dx) > 40) ir(actual + (dx < 0 ? 1 : -1));
        inicioX = null;
      });

      programar();
    })();
