extends ../layoutCliente.pug

block titulo
  | Inicio · Urbana Cult

block content
  if mensajeExito
    .alerta.alerta-exito ✅ #{mensajeExito}

  section.hero
    h1 ¡Hola, #{usuarioLogueado.nombreUsuario}! 👋
    p Descubrí las próximas funciones, gestioná tus entradas y aprovechá los beneficios de tu membresía.
    .fila.mt
      a.btn.btn-grande(href="/cliente/comprar" style="background:#fff;color:#161a2b") 🎟️ Ver cartelera
      if usuarioCompleto && usuarioCompleto.porcentajeDescuento > 0
        span.insignia(style="background:rgba(255,255,255,.18);color:#fff") ⭐ Tenés #{Math.round(usuarioCompleto.porcentajeDescuento * 100)}% de descuento en todas tus compras

  .encabezado-pagina
    div
      h2.mb-0 Accesos rápidos

  .grilla.grilla-4
    a.acceso-rapido(href="/cliente/comprar")
      span.icono-grande 🎟️
      div
        h4 Cartelera
        p Explorá eventos y comprá entradas
    a.acceso-rapido(href="/cliente/carrito")
      span.icono-grande 🛒
      div
        h4 Mi carrito
        p Revisá lo que vas a comprar
    a.acceso-rapido(href="/cliente/mis-compras")
      span.icono-grande 📦
      div
        h4 Mis entradas
        p Tickets vigentes e historial
    a.acceso-rapido(href="/cliente/membresia")
      span.icono-grande ⭐
      div
        h4 Membresía
        p Cambiá de plan y ahorrá
