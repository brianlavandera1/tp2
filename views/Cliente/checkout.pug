extends ../layoutCliente.pug

block titulo
  | Pago · Urbana Cult

block content
  .encabezado-pagina
    div
      .miga
        a(href="/cliente/carrito") Carrito
        |  / Pago
      h1 Finalizar compra
      p Completá los datos de tu tarjeta para confirmar el pago.

  .grilla.grilla-lateral
    .tarjeta
      if error
        .alerta.alerta-error(role="alert") ⚠️ #{error}

      form(action="/cliente/carrito/procesar-pago" method="POST")
        .campo
          label(for="medioPago") Medio de pago
          select#medioPago(name="medioPago")
            each medio in ['Tarjeta de Crédito', 'Tarjeta de Débito', 'Mercado Pago']
              option(value=medio selected=(datos && datos.medioPago === medio))= medio

        .campo
          label(for="titular") Titular de la tarjeta
          input#titular(type="text" name="titular" required placeholder="Nombre y apellido" autocomplete="cc-name" value=(datos ? datos.titular : '') onkeypress="return (event.charCode >= 65 && event.charCode <= 90) || (event.charCode >= 97 && event.charCode <= 122) || event.charCode === 32 || event.charCode === 209 || event.charCode === 241")

        .campo
          label(for="numeroTarjeta") Número de tarjeta
          input#numeroTarjeta(type="text" name="numeroTarjeta" required maxlength="16" inputmode="numeric" placeholder="16 dígitos" autocomplete="cc-number" onkeypress="return event.charCode >= 48 && event.charCode <= 57")

        .campos
          .campo
            label(for="vencimiento") Vencimiento
            input#vencimiento(type="text" name="vencimiento" required placeholder="MM/AA" maxlength="5" autocomplete="cc-exp" value=(datos ? datos.vencimiento : '') onkeypress="return (event.charCode >= 48 && event.charCode <= 57) || event.charCode === 47")
          .campo
            label(for="cvv") CVV
            input#cvv(type="password" name="cvv" required maxlength="3" inputmode="numeric" placeholder="3 dígitos" autocomplete="cc-csc" onkeypress="return event.charCode >= 48 && event.charCode <= 57")

        .acciones-formulario.entre
          a.btn.btn-enlace(href="/cliente/carrito") ← Volver al carrito
          button.btn.btn-exito.btn-grande(type="submit") Confirmar pago

    aside.tarjeta
      h3 Resumen
      .resumen
        .linea
          span Subtotal
          span $#{subtotal.toLocaleString('es-AR')}
        if porcentajeDescuento > 0
          .linea.texto-exito
            span Descuento (#{porcentajeDescuento}%)
            span −$#{descuentoAplicado.toLocaleString('es-AR')}
        .total
          span Total a pagar
          span.precio $#{total.toLocaleString('es-AR')}
      p.texto-tenue.mt.mb-0 🔒 Es un pago simulado: no se realizan cobros reales.
