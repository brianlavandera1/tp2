extends ../layoutCliente.pug
include ../partials/plan.pug

block titulo
  | Pago · Urbana Cult

block content
  - const plata = (n) => `$${Math.round(n).toLocaleString('es-AR')}`
  - const nombrePlan = { PREMIUM: 'Premium', VIP: 'VIP' }[usuarioLogueado.tipoCliente] || 'Estándar'

  .encabezado-pagina
    h1 Pago

  .grilla.grilla-lateral
    section.tarjeta
      if error
        .alerta.alerta-error(role="alert") #{error}

      form(action="/cliente/carrito/procesar-pago" method="POST")
        .campo
          label(for="medioPago") Medio de pago
          select#medioPago(name="medioPago")
            each medio in ['Tarjeta de Crédito', 'Tarjeta de Débito', 'Mercado Pago']
              option(value=medio selected=(datos && datos.medioPago === medio))= medio

        .campo
          label(for="titular") Titular de la tarjeta
          input#titular(type="text" name="titular" required placeholder="Nombre y apellido" autocomplete="cc-name" value=(datos ? datos.titular : '') onkeypress="return (event.charCode >= 65 && event.charCode <= 90) || (event.charCode >= 97 && event.charCode <= 122) || event.charCode === 32 || event.charCode === 209 || event.charCode === 241")

        .campo
          label(for="numeroTarjeta") Número de tarjeta
          input#numeroTarjeta(type="text" name="numeroTarjeta" required maxlength="16" inputmode="numeric" placeholder="16 dígitos" autocomplete="cc-number" onkeypress="return event.charCode >= 48 && event.charCode <= 57")

        .campos
          .campo
            label(for="vencimiento") Vencimiento
            input#vencimiento(type="text" name="vencimiento" required placeholder="MM/AA" maxlength="5" autocomplete="cc-exp" value=(datos ? datos.vencimiento : '') onkeypress="return (event.charCode >= 48 && event.charCode <= 57) || event.charCode === 47")
          .campo
            label(for="cvv") CVV
            input#cvv(type="password" name="cvv" required maxlength="3" inputmode="numeric" placeholder="3 dígitos" autocomplete="cc-csc" onkeypress="return event.charCode >= 48 && event.charCode <= 57")

        .acciones-formulario.entre
          a.btn.btn-enlace(href="/cliente/carrito") ← Volver
          button.btn.btn-grande(type="submit") Confirmar pago

    aside.tarjeta.caja-total
      +avisoPlan(usuarioLogueado)
      ul.detalle-compra
        each item in carrito
          li
            span
              strong= item.nombreEvento
              small #{item.tipoEntrada} · #{item.cantidad} #{item.cantidad === 1 ? 'entrada' : 'entradas'}
            span= plata(item.precio * item.cantidad)
      .resumen
        .linea
          span Precio original
          span= plata(subtotal)
        if porcentajeDescuento > 0
          .linea.linea-ahorro
            span Descuento plan #{nombrePlan} (#{Math.round(porcentajeDescuento)}%)
            span −#{plata(descuentoAplicado)}
        .total
          span Precio final
          span.precio= plata(total)
      p.texto-tenue.mt.mb-0 Pago simulado: no se realizan cobros reales.

  style.
    .caja-total { position: sticky; top: 88px; }
    .detalle-compra { display: grid; gap: 10px; margin: 0 0 14px; padding: 0 0 14px; border-bottom: 1px solid var(--color-borde); list-style: none; font-size: 14px; }
    .detalle-compra li { display: flex; justify-content: space-between; gap: 12px; }
    .detalle-compra strong { display: block; font-weight: 600; }
    .detalle-compra small { color: var(--color-texto-suave); font-size: 13px; }
    .caja-total .resumen .linea-ahorro { color: var(--color-exito); }
    .caja-total .resumen .total { border-top: 0; padding-top: 0; }
    .caja-total .resumen .linea + .total { border-top: 1px solid var(--color-borde); padding-top: 12px; }
