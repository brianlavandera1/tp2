extends ../layoutCliente.pug

block titulo
  | Membresía · Urbana Cult

block content
  .encabezado-pagina
    div
      h1 Elegí tu plan
      p Los planes pagos te dan descuento en todas tus compras de entradas.

  if error
    .alerta.alerta-error(role="alert") ⚠️ #{error}

  - const planActual = usuarioCompleto && usuarioCompleto.tipoCliente ? usuarioCompleto.tipoCliente : 'ESTANDAR'
  - const elegido = datos && datos.tipoCliente ? datos.tipoCliente : planActual
  - const planes = [{ valor: 'ESTANDAR', nombre: 'Estándar', precio: '$0', detalle: 'Acceso a toda la cartelera, sin costo mensual.', color: 'var(--color-texto)' }, { valor: 'PREMIUM', nombre: 'Premium', precio: '$2.000', detalle: '15% de descuento en todas tus entradas.', color: 'var(--color-info)' }, { valor: 'VIP', nombre: 'VIP', precio: '$5.000', detalle: '30% de descuento y atención prioritaria.', color: 'var(--color-marca)' }]

  form(action="/cliente/procesar-membresia" method="POST")
    .planes
      each plan in planes
        label.plan
          input(type="radio" name="tipoCliente" value=plan.valor checked=(elegido === plan.valor))
          .plan-caja
            if planActual === plan.valor
              span.insignia.insignia-exito.plan-actual Tu plan actual
            .nombre-plan(style=`color:${plan.color}`)= plan.nombre
            .precio-plan= plan.precio
              small  / mes
            p= plan.detalle

    .tarjeta
      .tarjeta-titulo
        h3 💳 Datos de pago
        span.texto-tenue Obligatorio solo para Premium o VIP
      .campo
        label(for="titular") Titular de la tarjeta
        input#titular(type="text" name="titular" placeholder="Nombre y apellido" value=(datos ? datos.titular : '') onkeypress="return (event.charCode >= 65 && event.charCode <= 90) || (event.charCode >= 97 && event.charCode <= 122) || event.charCode === 32 || event.charCode === 209 || event.charCode === 241")
      .campo
        label(for="numeroTarjeta") Número de tarjeta
        input#numeroTarjeta(type="text" name="numeroTarjeta" maxlength="16" inputmode="numeric" placeholder="16 dígitos" value=(datos ? datos.numeroTarjeta : '') onkeypress="return event.charCode >= 48 && event.charCode <= 57")
      .campos
        .campo
          label(for="vencimiento") Vencimiento
          input#vencimiento(type="text" name="vencimiento" maxlength="5" placeholder="MM/AA" value=(datos ? datos.vencimiento : '') onkeypress="return (event.charCode >= 48 && event.charCode <= 57) || event.charCode === 47")
        .campo
          label(for="cvv") CVV
          input#cvv(type="password" name="cvv" maxlength="3" inputmode="numeric" placeholder="3 dígitos" onkeypress="return event.charCode >= 48 && event.charCode <= 57")
      .acciones-formulario
        button.btn.btn-exito.btn-grande(type="submit") Confirmar plan
