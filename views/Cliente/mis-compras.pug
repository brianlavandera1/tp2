extends ../layoutCliente.pug

block titulo
  | Mis entradas · Urbana Cult

block content
  .encabezado-pagina
    div
      h1 Mis entradas
      p Mostrá el código de tu entrada en el acceso. Podés cancelarla si no vas a asistir.

  .grilla.grilla-lateral
    //- ENTRADAS ACTIVAS
    section
      h2 Entradas activas
      if misEntradasCompradas && misEntradasCompradas.length > 0
        .lista
          each entrada in misEntradasCompradas
            article.ticket(id=`ticket-${entrada._id}`)
              .ticket-principal
                if entrada.evento
                  h4= entrada.evento.nombre
                  if entrada.evento.entidad
                    p.texto-suave.mb-0 🎤 #{entrada.evento.entidad.nombre}
                  .evento-meta.mt(style="margin-top:10px")
                    span 📅 #{new Date(entrada.evento.fecha).toLocaleDateString('es-AR')}
                    span ⏰ #{entrada.evento.hora || '21:00'} hs
                    if entrada.evento.sala
                      span 📍 #{entrada.evento.sala.nombre}
                else
                  h4= entrada.nombre
                .fila(style="margin-top:12px")
                  span.insignia.insignia-marca 💺 #{entrada.sector || 'General'}
                  span.insignia.insignia-neutra 🎟️ #{entrada.cantidad || 1} entrada(s)
                  if entrada.estado === 'Usado'
                    span.insignia.insignia-aviso ✔ Usada el #{new Date(entrada.usadaEn).toLocaleDateString('es-AR')}
              .ticket-talon
                //- QR generado en el servidor (SVG) con la URL de validación de esta entrada
                if qrs && qrs[entrada._id]
                  .qr(role="img" aria-label=`Código QR de la entrada ${entrada.codigoBoleto}`)!= qrs[entrada._id]
                div
                  .texto-tenue Código
                  .codigo= entrada.codigoBoleto
                if entrada.estado !== 'Usado'
                  button.btn.btn-chico.btn-peligro-suave(type="button" onclick=`cancelarEntrada('${entrada._id}')`) Cancelar
      else
        .tarjeta.vacio
          .icono-vacio 🎟️
          h3 No tenés entradas activas
          p Cuando compres, tus entradas van a aparecer acá.
          a.btn(href="/cliente/comprar") Ver cartelera

    //- HISTORIAL DE COMPRAS
    aside.tarjeta
      h3 Historial de compras
      if misCompras && misCompras.length > 0
        .lista
          each compra in misCompras
            - const totalEntradas = compra.items ? compra.items.reduce((acc, item) => acc + (item.cantidad || 0), 0) : 0
            - const canceladas = compra.items ? compra.items.reduce((acc, item) => acc + (item.cantidadCancelada || 0), 0) : 0
            .item-lista
              .fila-entre
                span.codigo= compra.comprobanteId
                span.texto-tenue= new Date(compra.fechaCompra).toLocaleDateString('es-AR')
              .texto-suave(style="font-size:13px;margin:6px 0") #{totalEntradas} entrada(s) · #{compra.medioPago || 'Tarjeta'}
              .fila-entre
                strong $#{compra.total.toLocaleString('es-AR')}
                if canceladas
                  span.insignia.insignia-aviso #{canceladas} cancelada(s)
      else
        p.texto-tenue No hay compras registradas.

  script.
    async function cancelarEntrada(id) {
      if (!confirm('¿Seguro que querés cancelar esta entrada? El cupo se libera para otra persona.')) return;
      try {
        const respuesta = await fetch('/cliente/cancelar-entrada/' + id, { method: 'POST', headers: { 'Accept': 'application/json' } });
        const resultado = await respuesta.json();
        if (resultado.success) { location.reload(); }
        else { alert(resultado.message || 'No se pudo cancelar la entrada.'); }
      } catch (e) { alert('Error al cancelar.'); }
    }
