extends ../layoutCliente.pug
include ../partials/plan.pug

block titulo
  | Mi carrito · Urbana Cult

block content
  - const plata = (n) => `$${Math.round(n).toLocaleString('es-AR')}`
  - const meses = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic']
  - const totalEntradas = (carrito || []).reduce((suma, item) => suma + item.cantidad, 0)
  - const nombrePlan = { PREMIUM: 'Premium', VIP: 'VIP' }[usuarioLogueado.tipoCliente] || 'Estándar'
  - const conDescuento = (n) => n * (1 - porcentajeDescuento / 100)

  if carrito && carrito.length > 0
    .carrito-encabezado
      h1 Tu carrito
      span #{totalEntradas} #{totalEntradas === 1 ? 'entrada' : 'entradas'} · #[a(href="/cliente/comprar") Seguir comprando]

    .grilla.grilla-lateral.carrito-grilla
      section.lista-carrito(aria-label="Entradas en el carrito")
        each item, index in carrito
          - const fecha = item.fecha ? new Date(item.fecha) : null
          article.linea-carrito
            .linea-foto(style=item.urlFoto ? `background-image:url('${item.urlFoto}')` : undefined)
              if fecha
                span.linea-fecha
                  strong= fecha.getDate()
                  span= meses[fecha.getMonth()]
            .linea-cuerpo
              .linea-arriba
                div
                  h2= item.nombreEvento
                  p.linea-datos= [item.hora && `${item.hora} hs`, item.sala].filter(Boolean).join(' · ')
                form.en-linea(action=`/cliente/carrito/quitar/${index}` method="POST")
                  button.quitar(type="submit" aria-label=`Quitar ${item.nombreEvento} del carrito`) ×
              .linea-abajo
                .linea-sector
                  span.sector-marca= item.tipoEntrada
                  span.linea-unidad #{plata(item.precio)} c/u
                .linea-cantidad
                  form.en-linea(action=`/cliente/carrito/cantidad/${index}` method="POST")
                    input(type="hidden" name="paso" value="-1")
                    button(type="submit" aria-label=`Una entrada menos de ${item.nombreEvento}`) −
                  output(aria-label="Cantidad")= item.cantidad
                  form.en-linea(action=`/cliente/carrito/cantidad/${index}` method="POST")
                    input(type="hidden" name="paso" value="1")
                    button(type="submit" disabled=(item.restantes <= 0) aria-label=`Una entrada más de ${item.nombreEvento}`) +
                span.linea-precios
                  if porcentajeDescuento > 0
                    del.linea-original(aria-label=`Precio original ${plata(item.precio * item.cantidad)}`)= plata(item.precio * item.cantidad)
                  strong.linea-importe= plata(conDescuento(item.precio * item.cantidad))
              if item.restantes <= 0
                p.linea-aviso Ya tenés todas las entradas disponibles de este evento.

      aside.caja-total
        h2 Resumen
        +avisoPlan(usuarioLogueado)
        .resumen
          .linea
            span Precio original (#{totalEntradas} #{totalEntradas === 1 ? 'entrada' : 'entradas'})
            span= plata(subtotal)
          if porcentajeDescuento > 0
            .linea.linea-ahorro
              span Descuento plan #{nombrePlan} (#{Math.round(porcentajeDescuento)}%)
              span −#{plata(descuentoAplicado)}
          .total
            span Precio final
            span.precio= plata(total)
        if porcentajeDescuento > 0
          p.ahorro-destacado Con tu plan ahorrás #{plata(descuentoAplicado)} en esta compra
        a.btn.btn-bloque.btn-grande.mt(href="/cliente/carrito/checkout") Ir a pagar
        p.pago-nota Pago simulado: no se realizan cobros reales.

        //- Sugerencia de plan: solo si conviene de verdad, ya descontada la cuota mensual
        - const cuotaActual = porcentajeDescuento >= 15 ? 2000 : 0
        - const ahorroVip = subtotal * (30 - porcentajeDescuento) / 100 - (5000 - cuotaActual)
        if porcentajeDescuento < 30 && ahorroVip > 0
          a.sugerencia-plan(href="/cliente/membresia")
            strong Con VIP pagarías #{plata(ahorroVip)} menos
            span Ya contando la cuota del mes. Ver planes →
  else
    .carrito-vacio
      h1 Tu carrito está vacío
      p Elegí una función en la cartelera y agregá tus entradas.
      a.btn.btn-grande(href="/cliente/comprar") Ir a la cartelera

  style.
    .carrito-encabezado { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 6px 16px; margin: 6px 0 22px; }
    .carrito-encabezado h1 { margin: 0; }
    .carrito-encabezado span { color: var(--color-texto-suave); }
    .carrito-grilla { grid-template-columns: minmax(0, 1fr) 360px; gap: 22px; }

    .lista-carrito { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
    .linea-carrito { display: grid; grid-template-columns: 170px minmax(0, 1fr); border: 1px solid var(--color-borde); border-radius: 20px; overflow: hidden; background: var(--color-superficie); }
    .linea-foto { position: relative; min-height: 158px; background: linear-gradient(135deg, #2c2257, #5a2a8a 60%, #8a2f78) center 22% / cover no-repeat; }
    .linea-fecha { position: absolute; left: 10px; top: 10px; display: grid; justify-items: center; padding: 4px 10px; border-radius: 10px; background: #fff; color: #141418; line-height: 1.05; }
    .linea-fecha strong { font-size: 19px; font-weight: 700; }
    .linea-fecha span { font-size: 11px; font-weight: 600; color: #6d4dff; text-transform: uppercase; }
    .linea-cuerpo { display: flex; flex-direction: column; justify-content: space-between; gap: 14px; padding: 16px 18px; min-width: 0; }
    .linea-arriba { display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; }
    .linea-arriba > div { min-width: 0; }
    .linea-arriba h2 { margin: 0 0 3px; font-size: 20px; line-height: 1.15; text-wrap: balance; }
    .linea-datos { margin: 0; color: var(--color-texto-suave); font-size: 14px; }
    .quitar { flex: none; width: 32px; height: 32px; border: 0; border-radius: 50%; background: none; color: var(--color-texto-tenue); font-size: 22px; line-height: 1; cursor: pointer; }
    .quitar:hover { background: var(--color-error-suave); color: var(--color-error); }

    .linea-abajo { display: flex; align-items: center; flex-wrap: wrap; gap: 10px 16px; }
    .linea-sector { display: flex; align-items: center; gap: 8px; margin-right: auto; }
    .sector-marca { padding: 4px 11px; border-radius: 999px; background: var(--color-superficie-2); color: #fff; font-size: 13px; font-weight: 600; }
    .linea-unidad { color: var(--color-texto-suave); font-size: 13px; white-space: nowrap; }
    .linea-cantidad { display: flex; align-items: center; border-radius: 999px; background: var(--color-superficie-2); }
    .linea-cantidad button { width: 36px; height: 38px; border: 0; background: none; color: #fff; font-size: 18px; cursor: pointer; }
    .linea-cantidad button:disabled { color: var(--color-texto-tenue); opacity: .5; cursor: not-allowed; }
    .linea-cantidad output { min-width: 24px; text-align: center; font-weight: 600; font-variant-numeric: tabular-nums; }
    .linea-precios { display: grid; justify-items: end; line-height: 1.15; }
    .linea-original { color: var(--color-texto-tenue); font-size: 13px; }
    .linea-importe { min-width: 92px; text-align: right; font-size: 20px; font-weight: 600; letter-spacing: -.02em; font-variant-numeric: tabular-nums; }
    .linea-aviso { margin: 0; color: var(--color-aviso); font-size: 13px; }

    .caja-total { position: sticky; top: 84px; padding: 22px; border: 1px solid var(--color-borde); border-radius: 20px; background: var(--color-superficie); }
    .caja-total h2 { margin: 0 0 16px; }
    .caja-total .resumen .linea-ahorro { color: var(--color-exito); }
    .caja-total .resumen .total { align-items: baseline; font-weight: 500; }
    .caja-total .resumen .total .precio { font-size: 38px; letter-spacing: -.04em; }
    .ahorro-destacado { margin: 12px 0 0; padding: 9px 12px; border-radius: 12px; background: var(--color-exito-suave); color: var(--color-exito); font-size: 14px; font-weight: 500; text-align: center; }
    .pago-nota { margin: 10px 0 0; color: var(--color-texto-tenue); font-size: 12px; text-align: center; }
    .sugerencia-plan { display: grid; gap: 2px; margin-top: 16px; padding: 14px; border-radius: 14px; border: 1px solid rgba(124, 92, 255, .5); background: linear-gradient(135deg, rgba(109, 77, 255, .28), rgba(207, 58, 166, .22)); color: #fff; }
    .sugerencia-plan:hover { color: #fff; filter: brightness(1.15); }
    .sugerencia-plan span { color: #e6e1f5; font-size: 13px; }

    .carrito-vacio { max-width: 520px; margin: 50px auto 20px; padding: 44px 24px; border-radius: 24px; background: var(--color-superficie); text-align: center; }
    .carrito-vacio h1 { font-size: 30px; margin-bottom: 8px; }
    .carrito-vacio p { color: var(--color-texto-suave); margin: 0 0 22px; }

    @media (max-width: 960px) {
      .carrito-grilla { grid-template-columns: minmax(0, 1fr); }
      .caja-total { position: static; }
    }
    @media (max-width: 560px) {
      .linea-carrito { grid-template-columns: minmax(0, 1fr); }
      .linea-foto { min-height: 130px; }
      .linea-unidad { display: block; }
      .linea-precios { margin-left: auto; }
      .linea-importe { min-width: 0; }
      .linea-sector { width: 100%; }
    }
