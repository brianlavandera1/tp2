extends ../layoutCliente.pug

block titulo
  | Mi carrito · Urbana Cult

block content
  .encabezado-pagina
    div
      h1 Tu carrito
      p Revisá las entradas antes de pagar.

  if carrito && carrito.length > 0
    .grilla.grilla-lateral
      .tarjeta
        .tabla-contenedor
          table.tabla
            thead
              tr
                th Evento
                th Sector
                th.num Precio
                th.num Cantidad
                th.num Subtotal
                th
            tbody
              each item, index in carrito
                tr
                  td.negrita= item.nombreEvento
                  td
                    span.insignia.insignia-marca= item.tipoEntrada
                  td.num $#{item.precio.toLocaleString('es-AR')}
                  td.num= item.cantidad
                  td.num.negrita $#{(item.precio * item.cantidad).toLocaleString('es-AR')}
                  td.derecha
                    form.en-linea(action=`/cliente/carrito/quitar/${index}` method="POST")
                      button.btn.btn-chico.btn-peligro-suave(type="submit" aria-label=`Quitar ${item.nombreEvento}`) Quitar
        .mt
          a(href="/cliente/comprar") ← Seguir comprando

      aside.tarjeta
        h3 Resumen de compra
        .resumen
          .linea
            span Subtotal
            span $#{subtotal.toLocaleString('es-AR')}
          if porcentajeDescuento > 0
            .linea.texto-exito
              span Descuento membresía (#{porcentajeDescuento}%)
              span −$#{descuentoAplicado.toLocaleString('es-AR')}
          .total
            span Total
            span.precio $#{total.toLocaleString('es-AR')}
        a.btn.btn-exito.btn-bloque.btn-grande.mt(href="/cliente/carrito/checkout") Ir a pagar
        p.texto-tenue.centrado.mt.mb-0 🔒 Pago simulado y seguro
  else
    .tarjeta.vacio
      .icono-vacio 🛒
      h3 Tu carrito está vacío
      p Elegí una función en la cartelera y agregá tus entradas.
      a.btn(href="/cliente/comprar") Ir a la cartelera
