doctype html
include partials/logo.pug
include partials/conectados.pug
include partials/iconos.pug
include partials/tema.pug
html(lang="es")
  head
    include partials/head.pug
    include partials/estilosUrbana.pug
    include partials/estilosPanel.pug
    include partials/estilosTema.pug
    +scriptConectados()
    title
      block titulo
        | Urbana Cult · Panel de gestión
    block headStyles
  body
    .panel
      .marca-respaldo
        +logoMarca("/admin/dashboard", "Gestión")
        button.boton-modulos(type="button" aria-label="Mostrar barra de módulos" aria-expanded="true" aria-controls="menu-panel" title="Mostrar barra de módulos")
          +icono('menu')
      //- MENÚ LATERAL DEL PANEL (se adapta según el rol)
      aside.lateral
        .marca-panel
          +logoMarca("/admin/dashboard", "Gestión")
          button.boton-modulos(type="button" aria-label="Ocultar barra de módulos" aria-expanded="true" aria-controls="menu-panel" title="Ocultar barra de módulos")
            +icono('menu')

        - const rol = usuarioLogueado ? usuarioLogueado.rol : ''
        - const puedeVender = ['Administrador', 'Supervisor'].includes(rol)
        //- Cada área del panel tiene su color: se repite en el menú, en la ruta y en las tablas de sus pantallas
        - const grupos = [['Día a día', 'dia', [['/admin/dashboard', 'inicio', 'Panel'], puedeVender && ['/admin/boleteria', 'entrada', 'Boletería'], puedeVender && ['/admin/validar', 'validar', 'Validar entradas']]], ['Cartelera', 'cartelera', [['/admin/eventos', 'cartelera', 'Eventos'], ['/admin/salas', 'sala', 'Salas'], ['/admin/entidades', 'artista', 'Artistas']]], ['Dinero', 'dinero', [['/admin/informe', 'informe', 'Informes'], ['/admin/pagos', 'pagos', 'Pagos'], ['/admin/cancelaciones', 'cancelar', 'Cancelaciones']]], ['Personas', 'personas', [['/admin/usuarios', 'usuarios', 'Usuarios'], puedeVender && ['/admin/actividad', 'actividad', 'Actividad']]]]
        - const ruta = rutaActual === '/admin/crear-personal' ? '/admin/usuarios' : rutaActual
        - const esActivo = (enlace) => ruta === enlace[0] || ruta.startsWith(enlace[0] + '/')
        - const grupoActivo = grupos.find(g => g[2].some(e => e && esActivo(e)))
        - const seccion = grupoActivo && grupoActivo[2].find(e => e && esActivo(e))
        button.boton-menu(type="button" aria-label="Menú" aria-expanded="false" aria-controls="menu-panel")
          +icono('menu')
          span Menú
        .cuerpo-lateral
          nav#menu-panel.menu-lateral(aria-label="Menú del panel")
            each grupo in grupos
              span.titulo-grupo(class=`area-${grupo[1]}`)= grupo[0]
              each enlace in grupo[2]
                if enlace
                  - const activo = esActivo(enlace)
                  a(href=enlace[0] class=[`area-${grupo[1]}`, activo ? 'activo' : ''] aria-current=(activo ? 'page' : undefined))
                    span.icono
                      +icono(enlace[1])
                    = enlace[2]

          if usuarioLogueado
            .usuario-panel
              span.avatar= usuarioLogueado.nombreUsuario.charAt(0)
              div
                .nombre= usuarioLogueado.nombreUsuario
                .rol= esSuperAdmin(usuarioLogueado) ? 'Superadministrador' : usuarioLogueado.rol
              a.salir(href="/auth/logout" title="Cerrar sesión" aria-label="Cerrar sesión")
                +icono('salir')
                span Salir
          .control-tema-panel
            span Apariencia
            +botonTema(true)
          p.credito-panel Desarrollado por #[strong Sintaxia]

      //- ÁREA DINÁMICA (acá se carga cada página)
      main.panel-contenido(class=grupoActivo ? `area-${grupoActivo[1]}` : '')
        .panel-barra
          if seccion
            p.ruta-seccion
              span.ruta-icono
                +icono(seccion[1])
              | #{grupoActivo[0]} · #{seccion[2]}
          +contadorConectados()
        block content

    script.
      // Celular: el menú se abre con su botón
      (() => {
        const lateral = document.querySelector('.lateral');
        const panel = document.querySelector('.panel');
        const escritorio = window.matchMedia('(min-width: 961px)');
        escritorio.addEventListener('change', () => {
          lateral.inert = escritorio.matches && panel.classList.contains('modulos-ocultos');
        });
        const botonesModulos = panel.querySelectorAll('.boton-modulos');
        const cambiarBarra = (oculto, moverFoco = false) => {
          panel.classList.toggle('modulos-ocultos', oculto);
          const etiqueta = oculto ? 'Mostrar barra de módulos' : 'Ocultar barra de módulos';
          botonesModulos.forEach((boton) => {
            boton.setAttribute('aria-expanded', String(!oculto));
            boton.setAttribute('aria-label', etiqueta);
            boton.title = etiqueta;
          });
          lateral.inert = escritorio.matches && oculto;
          if (moverFoco) {
            const destino = oculto ? panel.querySelector('.marca-respaldo .boton-modulos') : lateral.querySelector('.boton-modulos');
            destino.focus({ preventScroll: true });
          }
        };
        botonesModulos.forEach((botonModulos) => botonModulos.addEventListener('click', () => {
          cambiarBarra(!panel.classList.contains('modulos-ocultos'), true);
        }));
        const boton = lateral.querySelector('.boton-menu');
        boton.addEventListener('click', () => {
          boton.setAttribute('aria-expanded', String(lateral.classList.toggle('menu-abierto')));
        });
        const ocultarAlInteractuar = (evento) => {
          if (!evento.target.closest('.panel-contenido')) return;
          if (escritorio.matches) {
            if (!panel.classList.contains('modulos-ocultos')) cambiarBarra(true);
          } else {
            lateral.classList.remove('menu-abierto');
            boton.setAttribute('aria-expanded', 'false');
          }
        };
        document.addEventListener('pointerdown', ocultarAlInteractuar);
        document.addEventListener('focusin', ocultarAlInteractuar);
        lateral.querySelector('#menu-panel').addEventListener('click', (evento) => {
          const enlace = evento.target.closest('a[href]');
          if (!enlace || evento.ctrlKey || evento.metaKey || evento.shiftKey || evento.altKey) return;
          try { sessionStorage.setItem('ocultar-barra-al-navegar', '1'); } catch {}
          if (escritorio.matches) cambiarBarra(true);
          lateral.classList.remove('menu-abierto');
          boton.setAttribute('aria-expanded', 'false');
        });
        try {
          if (sessionStorage.getItem('ocultar-barra-al-navegar') === '1') {
            sessionStorage.removeItem('ocultar-barra-al-navegar');
            cambiarBarra(true);
          }
        } catch {}
      })();
      // Celular: cada celda lleva el título de su columna, para mostrar las filas como tarjetas
      document.querySelectorAll('.tabla').forEach((tabla) => {
        const titulos = [...tabla.querySelectorAll('thead th')].map(th => th.textContent.trim());
        if (!titulos.length) return;
        tabla.classList.add('tabla-tarjetas');
        tabla.querySelectorAll(':scope > tbody > tr, :scope > tfoot > tr').forEach((fila) => {
          [...fila.children].forEach((celda, i) => {
            if (titulos[i] && celda.colSpan === 1) celda.dataset.titulo = titulos[i];
          });
        });
      });
