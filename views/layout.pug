doctype html
include partials/logo.pug
include partials/iconos.pug
html(lang="es")
  head
    include partials/head.pug
    include partials/estilosUrbana.pug
    include partials/estilosPanel.pug
    title
      block titulo
        | Urbana Cult · Panel de gestión
    block headStyles
  body
    .panel
      //- MENÚ LATERAL DEL PANEL (se adapta según el rol)
      aside.lateral
        +logoMarca("/admin/dashboard", "Gestión")

        - const rol = usuarioLogueado ? usuarioLogueado.rol : ''
        - const puedeVender = ['Administrador', 'Supervisor'].includes(rol)
        //- Cada área del panel tiene su color: se repite en el menú, en la ruta y en las tablas de sus pantallas
        - const grupos = [['Día a día', 'dia', [['/admin/dashboard', 'inicio', 'Panel'], puedeVender && ['/admin/boleteria', 'entrada', 'Boletería'], puedeVender && ['/admin/validar', 'validar', 'Validar entradas']]], ['Cartelera', 'cartelera', [['/admin/eventos', 'cartelera', 'Eventos'], ['/admin/salas', 'sala', 'Salas'], ['/admin/entidades', 'artista', 'Artistas']]], ['Dinero', 'dinero', [['/admin/informe', 'informe', 'Informes'], ['/admin/pagos', 'pagos', 'Pagos'], ['/admin/cancelaciones', 'cancelar', 'Cancelaciones']]], ['Personas', 'personas', [['/admin/usuarios', 'usuarios', 'Usuarios'], puedeVender && ['/admin/actividad', 'actividad', 'Actividad']]]]
        - const ruta = rutaActual === '/admin/crear-personal' ? '/admin/usuarios' : rutaActual
        - const esActivo = (enlace) => ruta === enlace[0] || ruta.startsWith(enlace[0] + '/')
        - const grupoActivo = grupos.find(g => g[2].some(e => e && esActivo(e)))
        - const seccion = grupoActivo && grupoActivo[2].find(e => e && esActivo(e))
        button.boton-menu(type="button" aria-label="Menú" aria-expanded="false" aria-controls="menu-panel")
          +icono('menu')
          span Menú
        nav#menu-panel.menu-lateral(aria-label="Menú del panel")
          each grupo in grupos
            span.titulo-grupo(class=`area-${grupo[1]}`)= grupo[0]
            each enlace in grupo[2]
              if enlace
                - const activo = esActivo(enlace)
                a(href=enlace[0] class=[`area-${grupo[1]}`, activo ? 'activo' : ''] aria-current=(activo ? 'page' : undefined))
                  span.icono
                    +icono(enlace[1])
                  = enlace[2]

        if usuarioLogueado
          .usuario-panel
            span.avatar= usuarioLogueado.nombreUsuario.charAt(0)
            div
              .nombre= usuarioLogueado.nombreUsuario
              .rol= esSuperAdmin(usuarioLogueado) ? 'Superadministrador' : usuarioLogueado.rol
            a.salir(href="/auth/logout" title="Cerrar sesión")
              +icono('salir')
              span Salir
        p.credito-panel Desarrollado por #[strong Sintaxia]

      //- ÁREA DINÁMICA (acá se carga cada página)
      main.panel-contenido(class=grupoActivo ? `area-${grupoActivo[1]}` : '')
        if seccion
          p.ruta-seccion
            span.ruta-icono
              +icono(seccion[1])
            | #{grupoActivo[0]} · #{seccion[2]}
        block content

    script.
      // Celular: el menú se abre con su botón
      (() => {
        const lateral = document.querySelector('.lateral');
        const boton = lateral.querySelector('.boton-menu');
        boton.addEventListener('click', () => {
          boton.setAttribute('aria-expanded', String(lateral.classList.toggle('menu-abierto')));
        });
      })();
      // Celular: cada celda lleva el título de su columna, para mostrar las filas como tarjetas
      document.querySelectorAll('.tabla').forEach((tabla) => {
        const titulos = [...tabla.querySelectorAll('thead th')].map(th => th.textContent.trim());
        if (!titulos.length) return;
        tabla.classList.add('tabla-tarjetas');
        tabla.querySelectorAll(':scope > tbody > tr, :scope > tfoot > tr').forEach((fila) => {
          [...fila.children].forEach((celda, i) => {
            if (titulos[i] && celda.colSpan === 1) celda.dataset.titulo = titulos[i];
          });
        });
      });
