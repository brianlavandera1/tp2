doctype html
include partials/logo.pug
html(lang="es")
  head
    include partials/head.pug
    title
      block titulo
        | Urbana Cult · Panel de gestión
    block headStyles
  body
    .panel
      //- MENÚ LATERAL DEL PANEL (se adapta según el rol)
      aside.lateral
        +logoMarca("/admin/dashboard", "Gestión")

        - const rol = usuarioLogueado ? usuarioLogueado.rol : ''
        - const puedeVender = ['Administrador', 'Supervisor'].includes(rol)
        - const grupos = [['General', [['/admin/dashboard', '🏠', 'Panel'], puedeVender && ['/admin/boleteria', '🎫', 'Boletería'], puedeVender && ['/admin/validar', '📷', 'Validar entradas']]], ['Cartelera', [['/admin/eventos', '🎭', 'Eventos'], ['/admin/salas', '🏛️', 'Salas'], ['/admin/entidades', '🎤', 'Artistas']]], ['Control', [['/admin/informe', '📊', 'Informes'], ['/admin/pagos', '💳', 'Pagos'], ['/admin/cancelaciones', '↩️', 'Cancelaciones'], ['/admin/usuarios', '👥', 'Usuarios'], puedeVender && ['/admin/actividad', '🕵️', 'Actividad']]]]
        nav.menu-lateral(aria-label="Menú del panel")
          each grupo in grupos
            span.titulo-grupo= grupo[0]
            each enlace in grupo[1]
              if enlace
                - const activo = rutaActual === enlace[0] || rutaActual.startsWith(enlace[0] + '/')
                a(href=enlace[0] class=(activo ? 'activo' : '') aria-current=(activo ? 'page' : undefined))
                  span.icono= enlace[1]
                  = enlace[2]

        if usuarioLogueado
          .usuario-panel
            span.avatar= usuarioLogueado.nombreUsuario.charAt(0)
            div
              .nombre= usuarioLogueado.nombreUsuario
              .rol= usuarioLogueado.rol
            a.salir(href="/auth/logout" title="Cerrar sesión") Salir
        p.credito-panel Desarrollado por #[strong Sintaxia]

      //- ÁREA DINÁMICA (acá se carga cada página)
      main.panel-contenido
        block content
