extends ../layoutAcceso.pug

block titulo
  | Iniciar sesión · Urbana Cult

block content
  h1 Iniciar sesión

  if exito
    .alerta.alerta-exito #{exito}
  if error
    .alerta.alerta-error(role="alert") #{error}

  form(action="/auth/login" method="POST")
    .campo
      label(for="identificador") Email o nombre de usuario
      input#identificador(type="text" name="identificador" required autocomplete="username" autocapitalize="none" autocorrect="off" spellcheck="false" placeholder="ej: cliente1 o correo@email.com" value=(typeof datos !== 'undefined' && datos ? datos.identificador : ''))
    .campo
      label(for="password") Contraseña
      input#password(type="password" name="password" required autocomplete="current-password" placeholder="••••••••")
    button.btn.btn-bloque.btn-grande(type="submit") Entrar

  p.centrado.texto-suave.mt
    | ¿No tenés cuenta? #[a.negrita(href="/auth/registro") Registrate gratis]
