extends ../layoutAcceso.pug

block titulo
  | Crear cuenta · Urbana Cult

block content
  h1 Crear cuenta

  if error
    .alerta.alerta-error(role="alert") #{error}

  form(action="/auth/registro" method="POST")
    .campo
      label(for="nombreUsuario") Nombre de usuario
      input#nombreUsuario(type="text" name="nombreUsuario" value=(datos ? datos.nombreUsuario : '') required autocomplete="username" autocapitalize="none" autocorrect="off" spellcheck="false" placeholder="ej: juanperez")

    .campos
      .campo
        label(for="nombre") Nombre
        input#nombre(type="text" name="nombre" value=(datos ? datos.nombre : '') required placeholder="Solo letras" onkeypress="return (event.charCode >= 65 && event.charCode <= 90) || (event.charCode >= 97 && event.charCode <= 122) || event.charCode === 32 || event.charCode === 209 || event.charCode === 241")
      .campo
        label(for="apellido") Apellido
        input#apellido(type="text" name="apellido" value=(datos ? datos.apellido : '') required placeholder="Solo letras" onkeypress="return (event.charCode >= 65 && event.charCode <= 90) || (event.charCode >= 97 && event.charCode <= 122) || event.charCode === 32 || event.charCode === 209 || event.charCode === 241")

    .campos
      .campo
        label(for="email") Correo electrónico
        input#email(type="email" name="email" value=(datos ? datos.email : '') required autocomplete="email" placeholder="correo@ejemplo.com")
      .campo
        label(for="password") Contraseña
        input#password(type="password" name="password" required autocomplete="new-password" placeholder="••••••••")

    .campos
      .campo
        label(for="dni") DNI
        input#dni(type="text" name="dni" value=(datos ? datos.dni : '') required minlength="7" maxlength="8" inputmode="numeric" placeholder="7 u 8 dígitos" onkeypress="return event.charCode >= 48 && event.charCode <= 57")
      .campo
        label(for="telefono") Teléfono
        input#telefono(type="text" name="telefono" value=(datos ? datos.telefono : '') required minlength="10" maxlength="15" inputmode="numeric" placeholder="10 a 15 dígitos" onkeypress="return event.charCode >= 48 && event.charCode <= 57")

    .campo
      label(for="fechaNacimiento") Fecha de nacimiento
      input#fechaNacimiento(type="date" name="fechaNacimiento" value=(datos ? datos.fechaNacimiento : '') required)
      .ayuda Tenés que ser mayor de 18 años.

    button.btn.btn-exito.btn-bloque.btn-grande(type="submit") Crear cuenta

  p.centrado.texto-suave.mt
    | ¿Ya tenés cuenta? #[a.negrita(href="/auth/login") Iniciá sesión]
