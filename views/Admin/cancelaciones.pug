extends ../layout.pug
include ../partials/paginacion.pug

block titulo
  | Cancelaciones · Urbana Cult

block content
  .encabezado-pagina
    div
      h1 Cancelaciones
      p Registro de auditoría de las entradas canceladas por los clientes.

  form.tarjeta.fila.mb(action="/admin/cancelaciones" method="GET")
    input(type="search" name="busqueda" placeholder="🔍 Cliente, evento o código de boleto" value=busqueda || '' aria-label="Buscar cancelaciones" style="flex:1;min-width:240px")
    button.btn(type="submit") Buscar
    if busqueda
      a.btn.btn-enlace(href="/admin/cancelaciones") Limpiar

  .tarjeta
    if cancelaciones && cancelaciones.length > 0
      .tabla-contenedor
        table.tabla
          thead
            tr
              th Cliente
              th Evento
              th Código
              th.num Cantidad
              th Fecha
          tbody
            each cancel in cancelaciones
              tr
                td.negrita= cancel.nombreCliente
                td= cancel.eventoNombre
                td
                  span.codigo= cancel.codigoBoleto
                td.num= cancel.cantidad
                td= new Date(cancel.fechaCancelacion).toLocaleString('es-AR')
      +paginacion(paginacion, "cancelaciones")
    else
      .vacio
        .icono-vacio ↩️
        p No hay cancelaciones registradas.
