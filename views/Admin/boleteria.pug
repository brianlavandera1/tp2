extends ../layout.pug

block titulo
  | Boletería · Urbana Cult

block headStyles
  style.
    /* Pantalla de carga y modal de confirmación propios de la boletería */
    .capa { display: none; position: fixed; inset: 0; z-index: 100; justify-content: center; align-items: center; background: rgba(18, 16, 31, .6); }
    .capa.visible { display: flex; }
    .capa-carga { flex-direction: column; color: #fff; background: rgba(18, 16, 31, .85); }
    .spinner { width: 60px; height: 60px; border: 6px solid rgba(255,255,255,.2); border-top-color: var(--color-marca); border-radius: 50%; animation: girar 1s linear infinite; margin-bottom: 20px; }
    @keyframes girar { to { transform: rotate(360deg); } }
    .modal { background: var(--color-superficie); padding: 28px; border-radius: var(--radio); text-align: center; max-width: 400px; width: calc(100% - 32px); box-shadow: var(--sombra-alta); }

block content
  //- PANTALLA DE CARGA
  #loadingOverlay.capa.capa-carga
    .spinner
    h2#loadingText Procesando pago... 0%
    p(style="color:rgba(255,255,255,.7)") Conectando con el medio de pago, por favor espere.

  //- CONFIRMACIÓN DEL COBRO
  #confirmModal.capa(role="dialog" aria-modal="true" aria-labelledby="tituloModal")
    .modal
      h3#tituloModal ⚠️ Confirmar cobro
      p.texto-suave ¿Seguro que querés realizar este cobro y emitir el ticket?
      .fila(style="justify-content:center")
        button#btnCancelarModal.btn.btn-secundario(type="button") Cancelar
        button#btnAceptarModal.btn.btn-exito(type="button") Sí, cobrar

  .encabezado-pagina
    div
      h1 Boletería
      p Venta presencial de entradas. El pago en efectivo tiene 25% de descuento.

  .grilla.grilla-lateral
    .tarjeta
      if error
        .alerta.alerta-error(role="alert") ⚠️ #{error}

      form#formCobro(action="/admin/boleteria/cobrar" method="POST")
        h3 Cliente
        .campos
          .campo
            label(for="dniCliente") DNI
            input#dniCliente(type="text" name="dniCliente" placeholder="Ej: 12345678" value=datosPrevios ? datosPrevios.dniCliente : '' required pattern="[0-9]{7,8}" minlength="7" maxlength="8" inputmode="numeric")
          .campo
            label(for="nombreCliente") Nombre y apellido
            input#nombreCliente(type="text" name="nombreCliente" placeholder="Ej: Juan Pérez" value=datosPrevios ? datosPrevios.nombreCliente : '' required pattern="[a-zA-ZáéíóúÁÉÍÓÚñÑ\\s]+" minlength="3" maxlength="80")

        h3 Entradas
        .campo
          label(for="eventoId") Evento
          select#eventoId(name="eventoId" required)
            each evt in eventos
              option(value=evt._id selected=(datosPrevios && datosPrevios.eventoId === evt._id.toString()) data-general=evt.precio data-platea=(evt.precioPlatea != null ? evt.precioPlatea : evt.precio) data-vip=(evt.precioVIP != null ? evt.precioVIP : evt.precio)) #{evt.nombre} — #{evt.entradasDisponibles} disponibles
        .campos-3
          .campo
            label(for="tipoEntrada") Sector
            - const sectorPrevio = datosPrevios ? datosPrevios.tipoEntrada : 'General'
            select#tipoEntrada(name="tipoEntrada" required)
              each sector in ['General', 'Platea', 'VIP']
                option(value=sector selected=(sectorPrevio === sector))= sector
          .campo
            label(for="inputCantidad") Cantidad
            input#inputCantidad(type="number" name="cantidad" value=datosPrevios ? datosPrevios.cantidad : '1' min="1" max="20" required)
          .campo
            label(for="inputPrecio") Precio unitario ($)
            input#inputPrecio(type="number" name="precioUnitario" value=datosPrevios ? datosPrevios.precioUnitario : '' min="0" step="0.01" required)
            .ayuda Se completa con el precio del sector.

        .campo
          label(for="selectMedioPago") Medio de pago
          select#selectMedioPago(name="medioPago" required)
            option(value="Efectivo" selected=(datosPrevios && datosPrevios.medioPago === 'Efectivo')) 💵 Efectivo en caja (25% desc.)
            option(value="Tarjeta POS" selected=(datosPrevios && datosPrevios.medioPago === 'Tarjeta POS')) 💳 Tarjeta (posnet)
            option(value="Transferencia Alias" selected=(datosPrevios && datosPrevios.medioPago === 'Transferencia Alias')) 📱 Transferencia / QR

    aside.tarjeta
      h3 Total a cobrar
      .resumen
        .linea
          span Subtotal
          span $
            span#lblSubtotal 0,00
        #boxDescuento.linea.texto-exito
          span Descuento efectivo (25%)
          span −$
            span#lblDescuento 0,00
        .total
          span Total
          span.precio $
            span#lblTotal 0,00
      button.btn.btn-exito.btn-bloque.btn-grande.mt(type="submit" form="formCobro") 🖨️ Cobrar y emitir ticket

  script.
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('formCobro');
      const overlay = document.getElementById('loadingOverlay');
      const text = document.getElementById('loadingText');
      const confirmModal = document.getElementById('confirmModal');

      const selectEvento = document.getElementById('eventoId');
      const selectSector = document.getElementById('tipoEntrada');
      const inputCantidad = document.getElementById('inputCantidad');
      const inputPrecio = document.getElementById('inputPrecio');
      const selectMedioPago = document.getElementById('selectMedioPago');
      const formato = n => n.toLocaleString('es-AR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

      // Precio del sector elegido según el evento (se puede modificar a mano)
      function completarPrecio() {
        const opcion = selectEvento.selectedOptions[0];
        if (!opcion) return;
        inputPrecio.value = opcion.dataset[selectSector.value.toLowerCase()] || opcion.dataset.general;
        calcularTotal();
      }

      function calcularTotal() {
        const subtotal = (parseInt(inputCantidad.value) || 0) * (parseFloat(inputPrecio.value) || 0);
        const descuento = selectMedioPago.value === 'Efectivo' ? subtotal * 0.25 : 0;
        document.getElementById('boxDescuento').classList.toggle('oculto', descuento === 0);
        document.getElementById('lblSubtotal').innerText = formato(subtotal);
        document.getElementById('lblDescuento').innerText = formato(descuento);
        document.getElementById('lblTotal').innerText = formato(subtotal - descuento);
      }

      selectEvento.addEventListener('change', completarPrecio);
      selectSector.addEventListener('change', completarPrecio);
      inputCantidad.addEventListener('input', calcularTotal);
      inputPrecio.addEventListener('input', calcularTotal);
      selectMedioPago.addEventListener('change', calcularTotal);
      if (!inputPrecio.value) completarPrecio(); else calcularTotal();

      // Confirmación propia antes de cobrar
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        if (!form.reportValidity()) return;
        confirmModal.classList.add('visible');
      });
      document.getElementById('btnCancelarModal').addEventListener('click', () => confirmModal.classList.remove('visible'));
      document.getElementById('btnAceptarModal').addEventListener('click', () => {
        confirmModal.classList.remove('visible');
        overlay.classList.add('visible');
        let porcentaje = 0;
        const intervalo = setInterval(() => {
          porcentaje = Math.min(99, porcentaje + Math.floor(Math.random() * 25) + 10);
          text.innerText = `Procesando pago... ${porcentaje}%`;
        }, 400);
        setTimeout(() => {
          clearInterval(intervalo);
          text.innerText = 'Pago aprobado ✅';
          setTimeout(() => form.submit(), 300);
        }, 2000);
      });

      // Filtros de teclado
      document.getElementById('dniCliente').addEventListener('input', function () { this.value = this.value.replace(/[^0-9]/g, ''); });
      document.getElementById('nombreCliente').addEventListener('input', function () { this.value = this.value.replace(/[^a-zA-ZáéíóúÁÉÍÓÚñÑ\s]/g, ''); });
    });
