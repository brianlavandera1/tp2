doctype html
html(lang="es")
  head
    include ../partials/head.pug
    title Ticket #{venta.comprobanteId} · Urbana Cult
    style.
      /* Ticket térmico de boletería */
      .ticket-impreso { font-family: ui-monospace, 'Courier New', monospace; background: #fff; width: 320px; padding: 22px; border: 1px dashed #333; box-shadow: var(--sombra-alta); font-size: 13px; color: #111; }
      .ticket-impreso h2 { font-family: var(--fuente); text-align: center; margin: 0; }
      .ticket-impreso .centro { text-align: center; }
      .ticket-impreso hr { border: 0; border-top: 1px dashed #333; margin: 12px 0; }
      .ticket-impreso p { margin: 4px 0; }
      .ticket-impreso .total { font-size: 18px; font-weight: 800; text-align: right; }
      @media print { .ticket-impreso { box-shadow: none; border: 0; width: 100%; } body { background: #fff; } }
  body
    .acceso-formulario(style="min-height:100vh;background:var(--color-fondo);align-content:center;gap:24px")
      .ticket-impreso
        h2 🎭 URBANA CULT
        p.centro Boletería · Sucursal principal
        hr
        p
          strong Ticket:
          |  #{venta.comprobanteId}
        p
          strong Fecha:
          |  #{venta.fechaCompra.toLocaleString('es-AR')}
        p
          strong Cajero:
          |  #{cajero}
        hr
        p
          strong Cliente:
          |  #{venta.nombreCliente}
        hr
        each item in venta.items
          p
            strong= item.nombreEvento
          p #{item.cantidad} × #{item.tipoEntrada} ($#{item.precio.toLocaleString('es-AR')})
        if entrada
          p
            strong Código de ingreso:
            |  #{entrada.codigoBoleto}
          if qr
            .qr(style="width:150px;margin:10px auto 0" role="img" aria-label="Código QR para el ingreso")!= qr
            p.centro(style="font-size:11px") Presentá este QR en el acceso
        hr
        if venta.descuentoAplicado > 0
          p Subtotal: $#{venta.subtotal.toLocaleString('es-AR')}
          p Descuento: −$#{venta.descuentoAplicado.toLocaleString('es-AR')}
        p.total TOTAL: $#{venta.total.toLocaleString('es-AR')}
        p.centro
          strong Medio:
          |  #{venta.medioPago}
        hr
        p.centro ¡Gracias por su compra!
        p.centro Conserve este ticket para el ingreso.
        p.centro(style="font-size:11px;margin-top:10px") Sistema desarrollado por Sintaxia

      .fila.no-imprimir(style="justify-content:center")
        button.btn(type="button" onclick="window.print()") 🖨️ Imprimir ticket
        a.btn.btn-secundario(href="/admin/boleteria") Nueva venta
