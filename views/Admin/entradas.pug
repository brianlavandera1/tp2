extends ../layout.pug

block titulo
  | Informes · Urbana Cult

block content
  - const hayFiltro = filtrosApli && (filtrosApli.fechaInicio || filtrosApli.fechaFin)
  .encabezado-pagina
    div
      h1 Informe de ventas
      p Entradas vendidas (sin las canceladas) y recaudación neta con descuentos.

  //- CAJA DEL DÍA
  if resumenHoy
    h3 📅 Hoy
    .grilla.grilla-3.mb
      .kpi
        .etiqueta-kpi Operaciones
        .valor= resumenHoy.totalTransacciones
      .kpi
        .etiqueta-kpi Entradas vendidas
        .valor= resumenHoy.totalVendidas
      .kpi.destacado
        .etiqueta-kpi Recaudación
        .valor $#{Math.round(resumenHoy.totalRecaudado).toLocaleString('es-AR')}

  //- FILTRO POR PERÍODO
  form.tarjeta.fila.mb(method="GET" action="/admin/informe" style="align-items:flex-end")
    .campo.mb-0
      label(for="fechaInicio") Desde
      input#fechaInicio(type="date" name="fechaInicio" value=(filtrosApli ? filtrosApli.fechaInicio : ''))
    .campo.mb-0
      label(for="fechaFin") Hasta
      input#fechaFin(type="date" name="fechaFin" value=(filtrosApli ? filtrosApli.fechaFin : ''))
    button.btn(type="submit") Filtrar
    if hayFiltro
      a.btn.btn-secundario(href="/admin/informe") Quitar filtros

  if resumen
    h3= hayFiltro ? '📊 Período seleccionado' : '📊 Histórico acumulado'
    .grilla.grilla-3.mb
      .kpi
        .etiqueta-kpi Operaciones
        .valor= resumen.totalTransacciones
      .kpi
        .etiqueta-kpi Entradas vendidas
        .valor= resumen.totalVendidas
      .kpi
        .etiqueta-kpi Recaudación
        .valor $#{Math.round(resumen.totalRecaudado).toLocaleString('es-AR')}

  .tarjeta
    h2 Desglose por evento
    if eventos && eventos.length > 0
      .tabla-contenedor
        table.tabla
          thead
            tr
              th Evento
              th Sala
              th.num Cupo
              th.num Vendidas
              th.num Disponibles
              th Ocupación
              th.num Recaudación
              th Estado
          tbody
            each ev in eventos
              tr
                td.negrita= ev.nombre
                td.texto-suave= ev.sala
                td.num= ev.cupo
                td.num.negrita= ev.vendidas
                td.num= ev.disponibles
                td
                  .fila(style="flex-wrap:nowrap;gap:8px")
                    .barra(style="flex:1")
                      span(style=`width:${Math.min(100, ev.porcentaje)}%`)
                    span.texto-tenue #{ev.porcentaje}%
                td.num.negrita $#{Number(ev.recaudado).toLocaleString('es-AR')}
                td
                  if ev.disponibles === 0
                    span.insignia.insignia-error Agotado
                  else if ev.porcentaje >= 85
                    span.insignia.insignia-aviso Últimos lugares
                  else
                    span.insignia.insignia-exito En venta
    else
      .vacio
        p No hay eventos registrados en este período.
