extends ../layout.pug
include ../partials/formUsuario.pug

block titulo
  | Nuevo usuario · Urbana Cult

block content
  .encabezado-pagina
    div
      .miga
        a(href="/admin/usuarios") Usuarios
        |  / Nuevo
      h1 Registrar usuario o personal

  .tarjeta.media
    if error
      .alerta.alerta-error(role="alert") ⚠️ #{error}

    form(action="/admin/crear-personal" method="POST")
      +camposUsuario(datos, true)
      .acciones-formulario.entre
        a.btn.btn-enlace(href="/admin/usuarios") ← Volver a usuarios
        button.btn.btn-exito(type="submit") Crear usuario
