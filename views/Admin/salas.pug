extends ../layout.pug
include ../partials/formSala.pug

block titulo
  | Salas · Urbana Cult

block content
  - const puedeEditar = usuarioLogueado && ['Administrador', 'Supervisor'].includes(usuarioLogueado.rol)
  .encabezado-pagina
    div
      h1 Salas
      p Espacios disponibles y su distribución por sector.
    if puedeEditar
      a.btn(href="#nueva-sala") + Nueva sala

  if exito
    .alerta.alerta-exito #{exito}
  if error
    .alerta.alerta-error(role="alert") #{error}

  if salas && salas.length > 0
    .grilla.grilla-auto.mb
      each s in salas
        - const z = s.zonas || {}
        article.tarjeta(style="margin:0")
          .fila-entre
            h3.mb-0= s.nombre
            span.insignia.insignia-marca #{s.capacidad} lugares
          p.texto-suave(style="margin:6px 0 14px") #{s.ubicacion || 'Sin ubicación'}
          each zona in ['General', 'Platea', 'VIP']
            - const cantidad = z[zona] || 0
            .fila-entre(style="font-size:13px;margin-bottom:4px")
              span= zona
              span.negrita= cantidad
            .barra(style="margin-bottom:10px")
              span(style=`width:${s.capacidad ? Math.round(cantidad / s.capacidad * 100) : 0}%`)
          if puedeEditar
            .fila(style="margin-top:14px")
              a.btn.btn-chico.btn-secundario(href=`/admin/salas/editar/${s._id}`) Editar
              form.en-linea(action=`/admin/salas/eliminar/${s._id}` method="POST" onsubmit="return confirm('¿Seguro que querés eliminar esta sala?');")
                button.btn.btn-chico.btn-peligro-suave(type="submit") Eliminar
  else
    .tarjeta.vacio.mb
      p No hay salas registradas.

  if puedeEditar
    .tarjeta#nueva-sala
      h2 Nueva sala
      form(action="/admin/salas" method="POST")
        +camposSala(datos)
        .acciones-formulario
          button.btn.btn-exito(type="submit") Crear sala
