extends ../layout.pug

block titulo
  | Panel · Urbana Cult

block content
  if error
    .alerta.alerta-error(role="alert") ⚠️ #{error}

  .encabezado-pagina
    div
      h1 ¡Hola, #{usuarioLogueado ? usuarioLogueado.nombreUsuario : 'Usuario'}! 👋
      p Resumen de la actividad de hoy, #{new Date().toLocaleDateString('es-AR', { weekday: 'long', day: 'numeric', month: 'long' })}.
    if usuarioLogueado && ['Administrador', 'Supervisor'].includes(usuarioLogueado.rol)
      a.btn(href="/admin/boleteria") 🎫 Nueva venta en boletería

  //- INDICADORES DEL DÍA (calculados en mostrarDashboard)
  - const ind = indicadores || { entradasHoy: 0, recaudadoHoy: 0, eventosActivos: 0, cancelacionesHoy: 0, totalClientes: 0 }
  .grilla.grilla-4.mb
    .kpi.destacado
      .etiqueta-kpi Recaudado hoy
      .valor $#{ind.recaudadoHoy.toLocaleString('es-AR')}
    .kpi
      .etiqueta-kpi Entradas vendidas hoy
      .valor= ind.entradasHoy
    .kpi
      .etiqueta-kpi Eventos próximos
      .valor= ind.eventosActivos
    .kpi
      .etiqueta-kpi Cancelaciones hoy
      .valor= ind.cancelacionesHoy

  .grilla.grilla-lateral
    section
      h2 Accesos rápidos
      .grilla.grilla-2
        a.acceso-rapido(href="/admin/eventos")
          span.icono-grande 🎭
          div
            h4 Eventos
            p Cartelera y programación
        a.acceso-rapido(href="/admin/salas")
          span.icono-grande 🏛️
          div
            h4 Salas
            p Espacios y sectores
        a.acceso-rapido(href="/admin/informe")
          span.icono-grande 📊
          div
            h4 Informes
            p Ventas por evento
        a.acceso-rapido(href="/admin/pagos")
          span.icono-grande 💳
          div
            h4 Pagos
            p Auditoría de transacciones
        a.acceso-rapido(href="/admin/usuarios")
          span.icono-grande 👥
          div
            h4 Usuarios
            p #{ind.totalClientes} cliente(s) registrados
        a.acceso-rapido(href="/admin/cancelaciones")
          span.icono-grande ↩️
          div
            h4 Cancelaciones
            p Historial de devoluciones
        if usuarioLogueado && ['Administrador', 'Supervisor'].includes(usuarioLogueado.rol)
          a.acceso-rapido(href="/admin/actividad")
            span.icono-grande 🕵️
            div
              h4 Actividad
              p #{ind.actividadHoy || 0} registro(s) hoy · quién hizo qué

    aside.tarjeta
      h3 Próxima función
      if proximoEvento
        h4(style="font-size:18px")= proximoEvento.nombre
        .evento-meta
          span 📅 #{new Date(proximoEvento.fecha).toLocaleDateString('es-AR')}
          span ⏰ #{proximoEvento.hora || '21:00'} hs
          if proximoEvento.sala
            span 📍 #{proximoEvento.sala.nombre}
        .mt
          span.insignia.insignia-exito #{proximoEvento.entradasDisponibles} entradas disponibles
        a.btn.btn-secundario.btn-bloque.mt(href="/admin/eventos") Ver eventos
      else
        p.texto-tenue No hay funciones programadas.
