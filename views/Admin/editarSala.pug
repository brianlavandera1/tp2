extends ../layout.pug
include ../partials/formSala.pug

block titulo
  | Editar sala · Urbana Cult

block content
  .encabezado-pagina
    div
      .miga
        a(href="/admin/salas") Salas
        |  / Editar
      h1 Editar sala

  .tarjeta.media
    if error
      .alerta.alerta-error(role="alert") #{error}

    form(action=`/admin/salas/editar/${sala._id}` method="POST")
      +camposSala(sala)
      .acciones-formulario.entre
        a.btn.btn-enlace(href="/admin/salas") ← Cancelar
        button.btn(type="submit") Guardar cambios
