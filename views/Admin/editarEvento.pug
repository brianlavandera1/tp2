extends ../layout.pug
include ../partials/formEvento.pug

block titulo
  | Editar evento · Urbana Cult

block content
  .encabezado-pagina
    div
      .miga
        a(href="/admin/eventos") Eventos
        |  / Editar
      h1= evento.nombre

  .tarjeta.media
    if error
      .alerta.alerta-error(role="alert") ⚠️ #{error}

    form(action=`/admin/eventos/editar/${evento._id}` method="POST")
      +camposEvento(evento, entidades, salas)
      .acciones-formulario.entre
        a.btn.btn-enlace(href="/admin/eventos") ← Cancelar
        button.btn(type="submit") Guardar cambios
