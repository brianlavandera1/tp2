extends ../layout.pug
include ../partials/formEvento.pug

block titulo
  | Eventos · Urbana Cult

block content
  - const puedeEditar = usuarioLogueado && ['Administrador', 'Supervisor'].includes(usuarioLogueado.rol)
  .encabezado-pagina
    div
      h1 Eventos
      p Cartelera completa con sala, fecha, precios y stock.
    if puedeEditar
      a.btn(href="#nuevo-evento") + Nuevo evento

  if exito
    .alerta.alerta-exito #{exito}
  if error
    .alerta.alerta-error(role="alert") #{error}

  .tarjeta
    if eventos && eventos.length > 0
      .tabla-contenedor
        table.tabla
          thead
            tr
              th Evento
              th Sala
              th Fecha
              th.num Precio
              th.num Stock
              if puedeEditar
                th
          tbody
            each ev in eventos
              tr
                td
                  .negrita= ev.nombre
                  .texto-tenue= ev.entidad ? ev.entidad.nombre : 'Sin artista'
                td= ev.sala ? ev.sala.nombre : 'Sin asignar'
                td
                  | #{new Date(ev.fecha).toLocaleDateString('es-AR')}
                  .texto-tenue #{ev.hora || ''} hs
                td.num
                  .negrita $#{ev.precio.toLocaleString('es-AR')}
                  if ev.precioPlatea != null || ev.precioVIP != null
                    .texto-tenue Platea $#{(ev.precioPlatea != null ? ev.precioPlatea : ev.precio).toLocaleString('es-AR')} · VIP $#{(ev.precioVIP != null ? ev.precioVIP : ev.precio).toLocaleString('es-AR')}
                td.num
                  if ev.entradasDisponibles > 0
                    span.insignia(class=ev.entradasDisponibles <= 50 ? 'insignia-aviso' : 'insignia-exito')= ev.entradasDisponibles
                  else
                    span.insignia.insignia-error Agotado
                if puedeEditar
                  td
                    .acciones-celda
                      a.btn.btn-chico.btn-secundario(href=`/admin/eventos/editar/${ev._id}`) Editar
                      form.en-linea(action=`/admin/eventos/eliminar/${ev._id}` method="POST" onsubmit="return confirm('¿Seguro que querés eliminar este evento?');")
                        button.btn.btn-chico.btn-peligro-suave(type="submit") Eliminar
    else
      .vacio
        p No hay eventos registrados.

  if puedeEditar
    .tarjeta#nuevo-evento
      h2 Nuevo evento
      form(action="/admin/eventos" method="POST")
        +camposEvento({}, entidades, salas)
        .acciones-formulario
          button.btn.btn-exito(type="submit") Crear evento
