extends ../layout.pug
include ../partials/paginacion.pug

block titulo
  | Usuarios · Urbana Cult

block content
  - const esAdmin = usuarioLogueado && usuarioLogueado.rol === 'Administrador'
  .encabezado-pagina
    div
      h1 Usuarios
      p Clientes y personal con acceso al sistema.
    if esAdmin
      a.btn(href="/admin/crear-personal") + Nuevo usuario

  if exito
    .alerta.alerta-exito ✅ #{exito}

  .tarjeta
    if usuarios && usuarios.length > 0
      - const colorRol = { Administrador: 'insignia-marca', Supervisor: 'insignia-info', Lector: 'insignia-neutra', Cliente: 'insignia-exito' }
      .tabla-contenedor
        table.tabla
          thead
            tr
              th Usuario
              th Nombre
              th Email
              th Rol
              th Plan
              if esAdmin
                th
          tbody
            each user in usuarios
              tr
                td
                  .fila(style="gap:10px;flex-wrap:nowrap")
                    span.avatar(style="width:30px;height:30px;font-size:12px")= user.nombreUsuario.charAt(0)
                    span.negrita= user.nombreUsuario
                td #{user.nombre} #{user.apellido}
                td(style="word-break:break-all")= user.email
                td
                  span.insignia(class=colorRol[user.rol] || 'insignia-neutra')= user.rol
                td= user.tipoCliente
                if esAdmin
                  td
                    .acciones-celda
                      a.btn.btn-chico.btn-secundario(href=`/admin/usuarios/editar/${user._id}`) Editar
                      form.en-linea(action=`/admin/usuarios/eliminar/${user._id}` method="POST" onsubmit="return confirm('¿Seguro que querés eliminar este usuario?');")
                        button.btn.btn-chico.btn-peligro-suave(type="submit") Eliminar
      +paginacion(paginacion, "usuarios")
    else
      .vacio
        .icono-vacio 👥
        p No hay usuarios registrados.
