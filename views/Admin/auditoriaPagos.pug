extends ../layout.pug

block titulo
  | Pagos · Urbana Cult

block content
  .encabezado-pagina
    div
      h1 Auditoría de pagos
      p Todas las compras online y ventas en boletería.

  //- BUSCADOR Y FILTRO DEL DÍA
  form.tarjeta.fila.mb(action="/admin/pagos" method="GET")
    if filtroActual === 'hoy'
      input(type="hidden" name="filtro" value="hoy")
    input(type="search" name="busqueda" placeholder="🔍 Evento, cliente, email, DNI o comprobante" value=busqueda || '' aria-label="Buscar pagos" style="flex:1;min-width:240px")
    button.btn(type="submit") Buscar
    if filtroActual === 'hoy'
      a.btn.btn-suave(href=`/admin/pagos${busqueda ? '?busqueda=' + encodeURIComponent(busqueda) : ''}`) Ver todos
    else
      a.btn.btn-secundario(href=`/admin/pagos?filtro=hoy${busqueda ? '&busqueda=' + encodeURIComponent(busqueda) : ''}`) Solo hoy
    if busqueda || filtroActual === 'hoy'
      a.btn.btn-enlace(href="/admin/pagos") Limpiar

  .tarjeta
    .tarjeta-titulo
      h2 Transacciones
      .fila
        if filtroActual === 'hoy'
          span.insignia.insignia-info 🕒 Solo hoy
        if busqueda
          span.insignia.insignia-neutra Buscando: “#{busqueda}”
        span.texto-tenue #{compras ? compras.length : 0} resultado(s)

    if compras && compras.length > 0
      .tabla-contenedor
        table.tabla
          thead
            tr
              th Comprobante
              th Cliente
              th Detalle
              th Medio de pago
              th.num Total
              th Fecha
          tbody
            each c in compras
              - const canceladas = (c.items || []).reduce((acc, item) => acc + (item.cantidadCancelada || 0), 0)
              tr
                td
                  .codigo= c.comprobanteId || 'REC-SYS'
                  .fila(style="gap:4px;margin-top:4px")
                    span.insignia(class=c.canal === 'Sucursal' ? 'insignia-info' : 'insignia-marca')= c.canal || 'Online'
                    if canceladas
                      span.insignia.insignia-aviso #{canceladas} cancelada(s)
                td
                  .negrita= c.nombreCliente || (c.cliente ? c.cliente.nombreUsuario : 'Cliente')
                  if c.cliente
                    .texto-tenue= c.cliente.email
                    .texto-tenue DNI #{c.cliente.dni || 'N/A'} · #{c.cliente.tipoCliente || 'ESTANDAR'}
                  else
                    .texto-tenue Cliente sin vincular
                td
                  if c.items && c.items.length > 0
                    details
                      summary #{c.items.length} ítem(s)
                      each item in c.items
                        .texto-tenue(style="margin-bottom:6px")
                          strong(style="color:var(--color-texto)")= item.nombreEvento
                          br
                          | #{item.tipoEntrada} · #{item.cantidad} × $#{(item.precio || 0).toLocaleString('es-AR')}
                          if item.cantidadCancelada
                            |  (#{item.cantidadCancelada} cancelada/s)
                  else
                    span.texto-tenue Sin detalle
                td
                  = c.medioPago
                  if c.tarjetaUltimosDigitos
                    .texto-tenue •••• #{c.tarjetaUltimosDigitos}
                td.num
                  .negrita $#{(c.total || 0).toLocaleString('es-AR')}
                  if c.descuentoAplicado > 0
                    .texto-tenue Subtotal $#{(c.subtotal || 0).toLocaleString('es-AR')}
                    .texto-exito(style="font-size:12px") −$#{c.descuentoAplicado.toLocaleString('es-AR')} desc.
                td
                  = new Date(c.fechaCompra).toLocaleDateString('es-AR')
                  .texto-tenue= new Date(c.fechaCompra).toLocaleTimeString('es-AR', { hour: '2-digit', minute: '2-digit' })
    else
      .vacio
        .icono-vacio 💳
        p No se encontraron transacciones.
