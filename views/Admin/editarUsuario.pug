extends ../layout.pug
include ../partials/formUsuario.pug

block titulo
  | Editar usuario · Urbana Cult

block content
  .encabezado-pagina
    div
      .miga
        a(href="/admin/usuarios") Usuarios
        |  / Editar
      h1 Editar usuario

  .tarjeta.media
    if error
      .alerta.alerta-error(role="alert") ⚠️ #{error}

    form(action=`/admin/usuarios/editar/${usuarioAEditar._id}` method="POST")
      +camposUsuario(usuarioAEditar, false)
      .acciones-formulario.entre
        a.btn.btn-enlace(href="/admin/usuarios") ← Volver
        button.btn(type="submit") Guardar cambios
