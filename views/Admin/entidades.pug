extends ../layout.pug
include ../partials/creditoFoto.pug

block titulo
  | Artistas · Urbana Cult

//- Selector de foto con vista previa (se reutiliza en el alta y en cada tarjeta)
mixin selectorFoto(id, etiqueta)
  label.selector-foto(for=id)
    input.input-foto(id=id type="file" name="foto" accept="image/jpeg,image/png,image/webp" data-preview=`preview-${id}`)
    span #{etiqueta}

block content
  - const puedeEditar = usuarioLogueado && ['Administrador', 'Supervisor'].includes(usuarioLogueado.rol)
  .encabezado-pagina
    div
      h1 Artistas y productoras
      p La foto de cada artista se usa de fondo en las tarjetas de la cartelera.

  if exito
    .alerta.alerta-exito #{exito}
  if error
    .alerta.alerta-error(role="alert") #{error}

  //- ALTA DE ARTISTA
  if puedeEditar
    form.tarjeta.alta-artista.mb(action="/admin/entidades/crear" method="POST" enctype="multipart/form-data")
      .artista-foto.vacia(id="preview-foto-nueva")
        span
      .alta-campos
        h3.mb-0 Nuevo artista
        p.texto-tenue Foto opcional · JPG, PNG o WEBP de hasta 2 MB.
        .fila
          input(type="text" name="nombre" placeholder="Nombre del artista, compañía o productora" required aria-label="Nombre del nuevo artista" style="flex:1;min-width:220px")
          +selectorFoto('foto-nueva', 'Elegir foto')
          button.btn.btn-exito(type="submit") + Agregar

  //- LISTADO EN TARJETAS
  if entidades && entidades.length > 0
    .grilla.artistas
      each ent in entidades
        article.tarjeta.artista
          .artista-foto(id=`preview-foto-${ent._id}` class=ent.urlFoto ? '' : 'vacia' style=ent.urlFoto ? `background-image:url('${ent.urlFoto}')` : undefined)
            if !ent.urlFoto
              span= ent.nombre.charAt(0)
            +creditoFoto(ent.fotoCredito, 'sobre-foto')
          if puedeEditar
            form.artista-cuerpo(action=`/admin/entidades/editar/${ent._id}` method="POST" enctype="multipart/form-data")
              input(type="text" name="nombre" value=ent.nombre required aria-label=`Nombre de ${ent.nombre}`)
              .fila(style="gap:8px")
                +selectorFoto(`foto-${ent._id}`, ent.urlFoto ? 'Cambiar foto' : 'Subir foto')
                if ent.urlFoto
                  label.texto-tenue.fila(style="gap:6px;cursor:pointer")
                    input(type="checkbox" name="quitarFoto" value="1")
                    | Quitar foto
              .fila(style="gap:8px")
                button.btn.btn-chico(type="submit") Guardar
                button.btn.btn-chico.btn-peligro-suave(type="submit" form=`eliminar-${ent._id}`) Eliminar
            form.oculto(id=`eliminar-${ent._id}` action=`/admin/entidades/eliminar/${ent._id}` method="POST" onsubmit="return confirm('¿Seguro que querés eliminar este artista?');")
          else
            .artista-cuerpo
              h4.mb-0= ent.nombre
  else
    .tarjeta.vacio
      p No hay artistas registrados.

  script.
    // Vista previa: muestra la imagen elegida antes de guardarla y avisa si supera los 2 MB
    document.querySelectorAll('.input-foto').forEach(input => {
      input.addEventListener('change', () => {
        const archivo = input.files[0];
        const etiqueta = input.nextElementSibling;
        if (!archivo) return;
        if (archivo.size > 2 * 1024 * 1024) {
          alert('La foto no puede superar los 2 MB.');
          input.value = '';
          return;
        }
        const preview = document.getElementById(input.dataset.preview);
        preview.style.backgroundImage = `url('${URL.createObjectURL(archivo)}')`;
        preview.classList.remove('vacia');
        preview.innerHTML = '';
        etiqueta.textContent = '' + (archivo.name.length > 18 ? archivo.name.slice(0, 15) + '…' : archivo.name);
      });
    });
